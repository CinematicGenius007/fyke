---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Docs from "../../components/Docs.astro";

export async function getStaticPaths() {
  const all = await getCollection("docs");
  return all
    .filter((e) => e.id !== "roadmap")
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const title = headings.find((h) => h.depth === 1)?.text ?? entry.id;
---
<Base title={title} current="docs" description={`${title}: a design document of Weir.`}>
  <div class="wrap">
    <div class="page">
      <Docs current={entry.id} />
      <article class="prose"><Content /></article>
    </div>
  </div>
</Base>

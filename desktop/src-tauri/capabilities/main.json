{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the reader window may do. The web viewer gets no capabilities at all.",
  "webviews": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-theme",
    "allow-call",
    "allow-subscribe",
    "allow-pause",
    "allow-data-home",
    "allow-test-mode",
    "allow-ready",
    "allow-quit",
    "allow-open-external",
    "allow-import-opml",
    "allow-export-opml",
    "allow-open-viewer",
    "allow-close-viewer",
    "allow-position-viewer",
    "allow-navigate-viewer",
    "notification:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}

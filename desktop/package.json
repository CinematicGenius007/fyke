  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.6",
    "@types/bun": "1.4.5",
    "@types/pngjs": "6.0.5",
    "axe-core": "4.14.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-solid": "2.11.17"

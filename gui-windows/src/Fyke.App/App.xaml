<Application x:Class="Fyke.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ArticleRule" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource HairlineBrush}" />
                <Setter Property="Margin" Value="0,8" />
            </Style>
            <Style x:Key="DiscussionReplyLine" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Background" Value="{ThemeResource HairlineBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Application x:Class="Fyke.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ArticleRule" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource HairlineBrush}" />
                <Setter Property="Margin" Value="0,8" />
            </Style>
            <!-- Article blocks, as the macOS reader draws them (gui/Sources/Reader/ReaderPane.swift). -->
            <Style x:Key="ArticleQuoteBar" TargetType="Border">
                <Setter Property="Width" Value="2" />
                <Setter Property="Background" Value="{ThemeResource ControlBrush}" />
            </Style>
            <Style x:Key="ArticleQuoteBody" TargetType="ContentPresenter">
                <Setter Property="Foreground" Value="{ThemeResource InkSoftBrush}" />
            </Style>
            <Style x:Key="ArticleCode" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="ArticleListMarker" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
            </Style>
            <Style x:Key="ArticleImageAction" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource UnreadBrush}" />
            </Style>
            <!-- A full-width row: the image's description on the left, the action on the right. -->
            <Style x:Key="ArticleImageLoad" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Chrome.Background" Value="{ThemeResource SelectedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Chrome.Background" Value="{ThemeResource SelectedStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Content.Opacity" Value="0.6" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DiscussionReplyLine" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Background" Value="{ThemeResource HairlineBrush}" />
            </Style>
            <!-- Today and a brief, as the macOS reader draws them (gui/Sources/Reader/Today.swift, Brief.swift). -->
            <Style x:Key="BriefInk" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
            </Style>
            <Style x:Key="BriefParagraph" TargetType="RichTextBlock">
                <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
            </Style>
            <Style x:Key="BriefSoft" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource InkSoftBrush}" />
            </Style>
            <Style x:Key="BriefMuted" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
            </Style>
            <Style x:Key="BriefUnread" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource UnreadBrush}" />
            </Style>
            <Style x:Key="BriefRead" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource ReadBrush}" />
            </Style>
            <Style x:Key="BriefTag" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SelectedBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Padding" Value="8,0" />
            </Style>
            <Style x:Key="BriefSpinner" TargetType="ProgressRing">
                <Setter Property="Width" Value="12" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource UnreadBrush}" />
            </Style>
            <Style x:Key="BriefDot" TargetType="Ellipse">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{ThemeResource UnreadBrush}" />
            </Style>
            <Style x:Key="BriefSoftIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource InkSoftBrush}" />
            </Style>
            <Style x:Key="BriefQuoteBar" TargetType="Border">
                <Setter Property="Width" Value="2" />
                <Setter Property="Background" Value="{ThemeResource UnreadBrush}" />
            </Style>
            <Style x:Key="BriefPopover" TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="MaxWidth" Value="372" />
            </Style>
            <!-- Text-only buttons: a citation number, a source row, a quiet action. -->
            <Style x:Key="BriefPlainButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Chrome.Background" Value="{ThemeResource SelectedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Chrome.Background" Value="{ThemeResource SelectedStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Content.Opacity" Value="0.6" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BriefCitation" TargetType="Button" BasedOn="{StaticResource BriefPlainButton}">
                <Setter Property="Foreground" Value="{ThemeResource UnreadBrush}" />
                <Setter Property="Padding" Value="2,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="BriefActiveCitation" TargetType="Button" BasedOn="{StaticResource BriefCitation}">
                <Setter Property="Background" Value="{ThemeResource SelectedBrush}" />
            </Style>
            <Style x:Key="BriefSourceRow" TargetType="Button" BasedOn="{StaticResource BriefPlainButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="36" />
            </Style>
            <Style x:Key="BriefQuietAction" TargetType="Button" BasedOn="{StaticResource BriefPlainButton}">
                <Setter Property="Foreground" Value="{ThemeResource UnreadBrush}" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Height" Value="28" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="BriefPrimaryAction" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="BriefSecondaryAction" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="RecipeRevisionRow" TargetType="Button" BasedOn="{StaticResource BriefSourceRow}">
                <Setter Property="Height" Value="44" />
                <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style x:Key="RecipeRevisionText" TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
            </Style>
            <Style x:Key="SettingsHairline" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource HairlineBrush}" />
            </Style>
            <Style x:Key="WriterBadge" TargetType="Border">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource ControlBrush}" />
            </Style>
            <Style x:Key="WriterBadgeFound" TargetType="Border" BasedOn="{StaticResource WriterBadge}">
                <Setter Property="Background" Value="{ThemeResource InkSoftBrush}" />
            </Style>
            <Style x:Key="WriterBadgeSelected" TargetType="Border" BasedOn="{StaticResource WriterBadge}">
                <Setter Property="Background" Value="{ThemeResource InkBrush}" />
            </Style>
            <Style x:Key="WriterBadgeText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource GroundBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="WriterProblem" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxLines" Value="2" />
            </Style>
            <Style x:Key="WriterDefaultTag" TargetType="Border">
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
                <Setter Property="Background" Value="{ThemeResource SelectedBrush}" />
            </Style>
            <Style x:Key="WriterDefaultText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="RoutineActionRow" TargetType="Border">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,0,4,0" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
            </Style>
            <Style x:Key="RoutineBar" TargetType="Border">
                <Setter Property="Width" Value="20" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Background" Value="{ThemeResource UnreadBrush}" />
            </Style>
            <Style x:Key="RoutineBarEmpty" TargetType="Border" BasedOn="{StaticResource RoutineBar}">
                <Setter Property="Background" Value="{ThemeResource HairlineBrush}" />
            </Style>
            <!-- Activity: the panel the status line opens, and the failed work in it. -->
            <Style x:Key="ActivityPopover" TargetType="FlyoutPresenter" BasedOn="{StaticResource BriefPopover}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MaxWidth" Value="420" />
            </Style>
            <Style x:Key="ActivityFailure" TargetType="Border">
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
                <Setter Property="Background" Value="{ThemeResource SelectedBrush}" />
            </Style>
            <Style x:Key="ActivityDot" TargetType="Ellipse">
                <Setter Property="Width" Value="6" />
                <Setter Property="Height" Value="6" />
                <Setter Property="Fill" Value="{ThemeResource UnreadBrush}" />
            </Style>
            <Style x:Key="ActivityQuietDot" TargetType="Ellipse" BasedOn="{StaticResource ActivityDot}">
                <Setter Property="Fill" Value="{ThemeResource ControlBrush}" />
            </Style>
            <Style x:Key="StorageSegment" TargetType="Border">
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Background" Value="{ThemeResource ControlBrush}" />
            </Style>
            <Style x:Key="StorageInkSegment" TargetType="Border" BasedOn="{StaticResource StorageSegment}">
                <Setter Property="Background" Value="{ThemeResource InkBrush}" />
            </Style>
            <Style x:Key="StorageSoftSegment" TargetType="Border" BasedOn="{StaticResource StorageSegment}">
                <Setter Property="Background" Value="{ThemeResource InkSoftBrush}" />
            </Style>
            <Style x:Key="StorageUnreadSegment" TargetType="Border" BasedOn="{StaticResource StorageSegment}">
                <Setter Property="Background" Value="{ThemeResource UnreadBrush}" />
            </Style>
            <Style x:Key="StorageConfirm" TargetType="Border">
                <Setter Property="Padding" Value="10" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
            </Style>
            <Style x:Key="ActivityError" TargetType="Border">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
            </Style>
            <Style x:Key="CatchUpSheet" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusSheet}" />
            </Style>
            <Style x:Key="CatchUpAction" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="56" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
                <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            </Style>
            <Style x:Key="CatchUpPrimaryAction" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Height" Value="56" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
                <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- The published app is compiled ahead of time: it starts without a JIT and ships only the
         code it reaches, the smallest of the measured options. -->
    <PublishAot>true</PublishAot>
    <!-- Debug symbols stay in the build folder; a published copy is what people download. -->
    <DebugType Condition="'$(_IsPublishing)' == 'true'">none</DebugType>
    <Platforms>x64</Platforms>
    <!-- Made by tools/gen_windows_icon.py from the Mac icon. The executable carries it, so the
         taskbar, Start menu, notifications and the installer show it. -->
    <ApplicationIcon>Assets\Fyke.ico</ApplicationIcon>
    <!-- CsWinRT's source generator, which ships with the Windows SDK projection, generates the WinRT
         interfaces of what crosses into XAML, which AOT cannot build by reflection. Level 2 warns,
         so fails the build, for any type it would miss. Its generated code needs unsafe blocks. -->
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs is the entry point: a second launch hands itself to the open window first. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Windows App SDK's components, not its metapackage: the app is self-contained, so every
         referenced component ships with it, and the metapackage adds machine learning (onnxruntime,
         DirectML), AI, Widgets and DWriteCore, about 45 MB that Fyke never loads. WinUI brings
         InteractiveExperiences and WebView2 with it; Foundation holds the file pickers. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.5" />
    <ProjectReference Include="..\Fyke.Client\Fyke.Client.csproj" />
    <ProjectReference Include="..\Fyke.ViewModels\Fyke.ViewModels.csproj" />
    <Content Include="Fonts\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fyke.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- An AOT publish of an unpackaged app leaves out the compiled XAML and the resource index, so
       loading MainWindow fails with "XAML parsing failed" (microsoft/WindowsAppSDK#6394, fixed in
       the MSIX build tools but not yet for unpackaged apps). Copy them until that ships. -->
  <Target Name="PublishCompiledXaml" AfterTargets="Publish" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <CompiledXaml Include="$(OutDir)**\*.xbf" />
      <CompiledXaml Include="$(OutDir)$(AssemblyName).pri" Condition="Exists('$(OutDir)$(AssemblyName).pri')" />
    </ItemGroup>
    <Copy SourceFiles="@(CompiledXaml)" DestinationFiles="@(CompiledXaml->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

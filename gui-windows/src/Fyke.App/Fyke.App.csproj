<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- The published app is compiled ahead of time: it starts without a JIT and ships only the
         code it reaches, the smallest of the measured options. -->
    <PublishAot>true</PublishAot>
    <!-- Debug symbols stay in the build folder; a published copy is what people download. -->
    <DebugType Condition="'$(_IsPublishing)' == 'true'">none</DebugType>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Windows App SDK's components, not its metapackage: the app is self-contained, so every
         referenced component ships with it, and the metapackage adds machine learning (onnxruntime,
         DirectML), AI, Widgets and DWriteCore, about 45 MB that Fyke never loads. WinUI brings
         InteractiveExperiences and WebView2 with it; Foundation holds the file pickers. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260204000" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260203002" />
    <ProjectReference Include="..\Fyke.Client\Fyke.Client.csproj" />
    <ProjectReference Include="..\Fyke.ViewModels\Fyke.ViewModels.csproj" />
    <Content Include="Fonts\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

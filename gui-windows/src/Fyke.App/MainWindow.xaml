                                           Style="{StaticResource SettingsDetail}" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" MinWidth="80" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Line spacing" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" x:Name="LineSpacingSlider" MaxWidth="200" HorizontalAlignment="Stretch"
                                        IsEnabled="False" ValueChanged="TextLayoutChanged" AutomationProperties.Name="Line spacing"
                                        AutomationProperties.AutomationId="LineSpacingSlider" />
                                <TextBlock Grid.Column="2" x:Name="LineSpacingValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Style="{StaticResource SettingsDetail}" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" MinWidth="80" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Column width" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" x:Name="ColumnWidthSlider" MaxWidth="200" HorizontalAlignment="Stretch"
                                        IsEnabled="False" ValueChanged="TextLayoutChanged" AutomationProperties.Name="Column width"
                                        AutomationProperties.AutomationId="ColumnWidthSlider" />

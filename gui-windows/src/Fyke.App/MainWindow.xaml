<Window x:Class="Fyke.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fyke.App"
    xmlns:vm="using:Fyke.ViewModels"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <Grid x:Name="Root">
        <Grid.Resources>
            <DataTemplate x:Key="FolderChoiceTemplate" x:DataType="vm:FolderChoice">
                <TextBlock Text="{x:Bind Name}" />
            </DataTemplate>
            <Style x:Key="ReadSearchTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource ReadBrush}" />
            </Style>
            <Style x:Key="UnreadSearchTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource UnreadBrush}" />
            </Style>
            <Style x:Key="ActiveArticleMark" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource UnreadBrush}" />
            </Style>
            <Style x:Key="InactiveArticleMark" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource InkSoftBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" />
        <Grid Grid.Row="1" x:Name="ReaderShell" Visibility="Collapsed" SizeChanged="ReaderSizeChanged"
              AutomationProperties.AutomationId="ReaderShell">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="C" Invoked="DiscussionShortcut" />
                <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchShortcut" />
                <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="PaletteShortcut" />
                <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="AddFeedShortcut" />
                <KeyboardAccelerator Key="F6" Invoked="PaneFocusShortcut" />
                <KeyboardAccelerator Key="F6" Modifiers="Shift" Invoked="PaneFocusShortcut" />
                <KeyboardAccelerator Key="M" Invoked="ArticleMarkShortcut" />
                <KeyboardAccelerator Key="S" Invoked="ArticleMarkShortcut" />
                <KeyboardAccelerator Key="R" Invoked="RefreshSubscriptionsShortcut" />
                <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="WriteBriefShortcut" />
                <KeyboardAccelerator Key="J" Modifiers="Control" Invoked="CatchUpShortcut" />
                <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="RoutinesShortcut" />
                <KeyboardAccelerator Key="A" Modifiers="Control,Shift" Invoked="AskShortcut" />
                <KeyboardAccelerator Key="K" Modifiers="Control,Shift" Invoked="MarkAllReadShortcut" />
                <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoBulkShortcut" />
                <KeyboardAccelerator Key="J" Invoked="NavigationShortcut" />
                <KeyboardAccelerator Key="K" Invoked="NavigationShortcut" />
                <KeyboardAccelerator Key="N" Invoked="NavigationShortcut" />
                <KeyboardAccelerator Key="U" Invoked="NavigationShortcut" />
                <KeyboardAccelerator Key="O" Invoked="NavigationShortcut" />
                <KeyboardAccelerator Key="O" Modifiers="Shift" Invoked="NavigationShortcut" />
                <KeyboardAccelerator Key="F" Invoked="NavigationShortcut" />
                <KeyboardAccelerator Key="A" Invoked="NavigationShortcut" />
                <KeyboardAccelerator Key="T" Invoked="NavigationShortcut" />
            </Grid.KeyboardAccelerators>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition x:Name="TimelineColumn" Width="368" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="SidebarPane" Padding="12,16,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="10,0,0,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="LIBRARY" FontSize="11" FontFamily="{StaticResource FontUi}" VerticalAlignment="Center"
                               FontWeight="{x:Bind local:ReaderFontWeights.Shared.SectionLabel, Mode=OneWay}"
                               Foreground="{ThemeResource MutedBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="CatchUpButton" Width="32" Height="32" Padding="0"
                                Click="CatchUpClicked" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="CatchUpButton" AutomationProperties.Name="Catch up"
                                AutomationProperties.AcceleratorKey="Ctrl+J" ToolTipService.ToolTip="Catch up (Ctrl+J)">
                            <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                        </Button>
                        <Button x:Name="AddFeedButton" Width="32" Height="32" Padding="0"
                                Click="AddFeedClicked" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="AddFeedButton" AutomationProperties.Name="Add feed"
                                AutomationProperties.AcceleratorKey="Ctrl+N" ToolTipService.ToolTip="Add feed (Ctrl+N)">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                        <Button x:Name="PaletteButton" Width="32" Height="32" Padding="0"
                                Click="PaletteClicked" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="PaletteButton" AutomationProperties.Name="Command palette"
                                AutomationProperties.AcceleratorKey="Ctrl+K" ToolTipService.ToolTip="Command palette (Ctrl+K)">
                            <FontIcon Glyph="&#xE765;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ListView Grid.Row="1" x:Name="Destinations" SelectionChanged="DestinationChanged" ItemClick="DestinationClicked"
                          AutomationProperties.Name="Reading destinations" AutomationProperties.AutomationId="ReaderDestinations">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReaderDestination">
                            <Grid Height="32" ColumnSpacing="8" DataContextChanged="ApplyDestinationIndent"
                                  AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14"
                                          Foreground="{ThemeResource InkSoftBrush}" />
                                <Button Width="24" Height="24" Padding="0" Margin="-5,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                                        Background="Transparent" BorderThickness="0" Foreground="{ThemeResource MutedBrush}"
                                        Loaded="FolderDisclosureLoaded" DataContextChanged="FolderDisclosureChanged"
                                        Click="FolderDisclosureClicked"
                                        CornerRadius="{StaticResource RadiusControl}">
                                    <FontIcon FontSize="10" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                           VerticalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind CountText}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                           Foreground="{ThemeResource UnreadBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="2" ColumnSpacing="8" Padding="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <!-- Routines, at the foot of the sidebar as on macOS, with the soonest run. Built in MainWindow.Routines.cs. -->
                    <Button Grid.ColumnSpan="2" x:Name="RoutinesButton" Height="32" Padding="10,0" Margin="0,0,0,4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="RoutinesClicked"
                            Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource RadiusControl}"
                            AutomationProperties.AutomationId="RoutinesButton" AutomationProperties.Name="Routines"
                            AutomationProperties.AcceleratorKey="Ctrl+4" ToolTipService.ToolTip="Routines (Ctrl+4)">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="{ThemeResource InkSoftBrush}" />
                            <TextBlock Grid.Column="1" Text="Routines" VerticalAlignment="Center" FontFamily="{StaticResource FontUi}"
                                       FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" Foreground="{ThemeResource InkBrush}" />
                            <TextBlock Grid.Column="2" x:Name="RoutinesNext" VerticalAlignment="Center" FontSize="12"
                                       FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource MutedBrush}"
                                       AutomationProperties.AutomationId="RoutinesNext" />
                        </Grid>
                    </Button>
                    <TextBlock Grid.Row="1" x:Name="SubscriptionStatus" Visibility="Collapsed" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="12" TextWrapping="Wrap" FontFamily="{StaticResource FontUi}"
                           FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                           Foreground="{ThemeResource MutedBrush}" AutomationProperties.LiveSetting="Polite" />
                    <Button Grid.Row="1" Grid.Column="1" x:Name="SettingsButton" Width="32" Height="32" Padding="0"
                            Click="SettingsClicked" CornerRadius="{StaticResource RadiusControl}"
                            AutomationProperties.AutomationId="SettingsButton" AutomationProperties.Name="Settings"
                            AutomationProperties.AcceleratorKey="Ctrl+," ToolTipService.ToolTip="Settings (Ctrl+,)">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                </Grid>
            </Grid>
            <Border Grid.Column="1" Background="{ThemeResource HairlineBrush}" />
            <Grid Grid.Column="2" x:Name="TimelinePane" Background="{ThemeResource GroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="20,16,20,12" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="TimelineHeading" FontSize="24"
                                   FontFamily="{StaticResource FontReading}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Title, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" Foreground="{ThemeResource InkBrush}"
                                   AutomationProperties.AutomationId="TimelineHeading" />
                        <TextBlock x:Name="ViewSummary" FontSize="12" Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                        <TextBlock x:Name="TodayDate" Visibility="Collapsed" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"
                                   FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                   Foreground="{ThemeResource MutedBrush}" AutomationProperties.AutomationId="TodayDate" />
                        <Button x:Name="EditViewButton" Width="32" Height="32" Padding="0" Visibility="Collapsed"
                                Click="EditViewClicked" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="EditViewButton" AutomationProperties.Name="Edit view"
                                ToolTipService.ToolTip="Edit view">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        </Button>
                        <Button x:Name="BulkReadButton" Width="32" Height="32" Padding="0" Visibility="Collapsed"
                                Click="MarkAllReadClicked" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="BulkReadButton" AutomationProperties.Name="Mark all read"
                                AutomationProperties.AcceleratorKey="Ctrl+Shift+K" ToolTipService.ToolTip="Mark all read (Ctrl+Shift+K)">
                            <FontIcon Glyph="&#xE8FB;" FontSize="14" />
                        </Button>
                        <Button x:Name="SearchButton" Width="32" Height="32" Padding="0"
                                Click="SearchClicked" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="SearchButton" AutomationProperties.Name="Search feeds"
                                AutomationProperties.AcceleratorKey="Ctrl+F" ToolTipService.ToolTip="Search (Ctrl+F)">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ListView Grid.Row="2" x:Name="Timeline" Margin="8,0" SelectionChanged="ArticleChanged"
                          AutomationProperties.Name="Articles" AutomationProperties.AutomationId="ReaderTimeline">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TimelineArticle">
                            <StackPanel Padding="4,8" Spacing="4" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" MaxLines="2"
                                           FontFamily="{StaticResource FontReading}"
                                           FontWeight="{x:Bind local:ReaderFontWeights.Shared.TimelineTitle, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock Text="{x:Bind FeedTitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                           Foreground="{ThemeResource MutedBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- Today: the briefs, newest first, under the brief being written. -->
                <ListView Grid.Row="2" x:Name="BriefRows" Margin="8,0" Visibility="Collapsed" SelectionChanged="BriefRowChanged"
                          AutomationProperties.Name="Briefs" AutomationProperties.AutomationId="BriefList">
                    <ListView.Header>
                        <StackPanel Padding="12,4,12,8" Spacing="8">
                            <TextBlock Text="BRIEFS" FontSize="11" CharacterSpacing="60"
                                       FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.SectionLabel, Mode=OneWay}"
                                       Foreground="{ThemeResource MutedBrush}" AutomationProperties.HeadingLevel="Level2" />
                            <Grid x:Name="WritingRow" Visibility="Collapsed" ColumnSpacing="8" Padding="0,4" AutomationProperties.LiveSetting="Polite">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ProgressRing Width="12" Height="12" IsActive="True" VerticalAlignment="Center"
                                              Foreground="{ThemeResource UnreadBrush}" AutomationProperties.Name="Working" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Writing a brief…" FontSize="14" FontFamily="{StaticResource FontUi}"
                                               FontWeight="{x:Bind local:ReaderFontWeights.Shared.SectionLabel, Mode=OneWay}"
                                               Foreground="{ThemeResource InkBrush}" />
                                    <TextBlock x:Name="WritingDetail" FontSize="12" FontFamily="{StaticResource FontUi}"
                                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource MutedBrush}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="BriefListEmpty" Visibility="Collapsed" FontSize="13" TextWrapping="Wrap"
                                       Text="Briefs you write appear here, newest first." FontFamily="{StaticResource FontUi}"
                                       Foreground="{ThemeResource MutedBrush}" />
                        </StackPanel>
                    </ListView.Header>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BriefListItem">
                            <StackPanel Padding="4,12" Spacing="4" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <TextBlock Text="{x:Bind Detail}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource MutedBrush}" />
                                <TextBlock Text="{x:Bind Title}" FontSize="18" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource FontReading}" FontWeight="Medium"
                                           DataContextChanged="BriefTitleChanged" />
                                <TextBlock Text="{x:Bind From}" FontSize="13" FontFamily="{StaticResource FontUi}"
                                           Foreground="{ThemeResource InkSoftBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="1" Margin="20,8" Spacing="8" x:Name="TimelineState">
                    <TextBlock x:Name="TimelineMessage" TextWrapping="Wrap" Foreground="{ThemeResource InkSoftBrush}"
                               FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="RetryTimeline" Content="Try again" Height="32" Click="RetryTimelineClicked"
                            FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                            Visibility="Collapsed" CornerRadius="{StaticResource RadiusControl}" />
                </StackPanel>
                <Button Grid.Row="3" x:Name="MoreArticles" Margin="16,8" Height="32" Content="Load more"
                        FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                        Visibility="Collapsed" Click="MoreArticlesClicked" CornerRadius="{StaticResource RadiusControl}" />
            </Grid>
            <primitives:Thumb Grid.Column="3" x:Name="TimelineDivider" IsTabStop="True" UseSystemFocusVisuals="True" DragDelta="TimelineDividerDragged" KeyDown="TimelineDividerKeyDown"
                              AutomationProperties.Name="Resize article list with Left and Right arrow keys">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="{ThemeResource GroundBrush}">
                            <Border HorizontalAlignment="Center" Width="1" Background="{ThemeResource HairlineBrush}" />
                        </Grid>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
            <Grid Grid.Column="4" x:Name="ArticlePane" Background="{ThemeResource GroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="ArticleActions" Margin="24,8,24,0" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <!-- An article opened from a brief's sources goes back to the brief. -->
                        <Button x:Name="BackToBrief" Visibility="Collapsed" Click="BackToBriefClicked" Style="{StaticResource BriefQuietAction}"
                                AutomationProperties.Name="Back to Brief" AutomationProperties.AutomationId="BackToBrief"
                                FontFamily="{StaticResource FontUi}" FontSize="13">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE76B;" FontSize="11" />
                                <TextBlock Text="Brief" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="MarkStatus" FontSize="13" Visibility="Collapsed" TextWrapping="Wrap"
                                   VerticalAlignment="Center" FontFamily="{StaticResource FontUi}"
                                   FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                   Foreground="{ThemeResource InkSoftBrush}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" x:Name="MarkButtons" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="StarArticle" Width="32" Height="32" Padding="0" Click="StarArticleClicked"
                                CornerRadius="{StaticResource RadiusControl}" AutomationProperties.AutomationId="StarArticle"
                                AutomationProperties.AcceleratorKey="S">
                            <FontIcon x:Name="StarMarkIcon" FontSize="14" />
                        </Button>
                        <Button x:Name="ReadArticle" Width="32" Height="32" Padding="0" Click="ReadArticleClicked"
                                CornerRadius="{StaticResource RadiusControl}" AutomationProperties.AutomationId="ReadArticle"
                                AutomationProperties.AcceleratorKey="M">
                            <FontIcon x:Name="ReadMarkIcon" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="ArticleScroller" Grid.Row="1" IsTabStop="True" UseSystemFocusVisuals="True"
                                  AutomationProperties.Name="Article reader"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ArticleColumn" Margin="24,20" Spacing="12" MaxWidth="640" HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="ArticlePane">
                        <TextBlock x:Name="ArticleHeading" FontSize="32" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   FontFamily="{StaticResource FontReading}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Title, Mode=OneWay}"
                                   AutomationProperties.AutomationId="ArticleHeading"
                                   Foreground="{ThemeResource InkBrush}" />
                        <TextBlock x:Name="ArticleSource" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"
                                   AutomationProperties.AutomationId="ArticleSource"
                                   FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                        <TextBlock x:Name="ArticleStatus" TextWrapping="Wrap" Foreground="{ThemeResource InkSoftBrush}"
                                   FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="RetryArticle" Content="Try again" Click="RetryArticleClicked"
                                FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                Visibility="Collapsed" Height="32" CornerRadius="{StaticResource RadiusControl}" />
                        <StackPanel x:Name="ArticleBody" Spacing="16" AutomationProperties.AutomationId="ArticleBody" />
                        <StackPanel x:Name="ArticleDiscussion" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
                            <Border Style="{StaticResource ArticleRule}" />
                            <TextBlock x:Name="DiscussionHeading" FontSize="15" TextWrapping="Wrap"
                                       FontFamily="{StaticResource FontUi}"
                                       FontWeight="{x:Bind local:ReaderFontWeights.Shared.SectionLabel, Mode=OneWay}"
                                       Foreground="{ThemeResource InkBrush}" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="DiscussionDetail" FontSize="13" TextWrapping="Wrap"
                                       FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                       Foreground="{ThemeResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="DiscussionAction" Height="32" Click="DiscussionActionClicked"
                                        AutomationProperties.AutomationId="DiscussionAction"
                                        AutomationProperties.AcceleratorKey="C"
                                        FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                        CornerRadius="{StaticResource RadiusControl}" />
                                <HyperlinkButton x:Name="DiscussionWebsite" Height="32"
                                                 FontFamily="{StaticResource FontUi}"
                                                 FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                            </StackPanel>
                            <ItemsRepeater x:Name="DiscussionComments" ElementPrepared="PrepareDiscussionComment"
                                           AutomationProperties.Name="Comments">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <ContentPresenter />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <!-- Today's reader: the chosen brief, or what is happening in its place. Built in MainWindow.Today.cs. -->
                <Grid x:Name="TodayPane" Grid.RowSpan="2" Visibility="Collapsed" Background="{ThemeResource GroundBrush}">
                    <ScrollViewer x:Name="TodayScroller" IsTabStop="True" UseSystemFocusVisuals="True"
                                  AutomationProperties.Name="Brief" AutomationProperties.AutomationId="TodayReader"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TodayColumn" Margin="40,72,40,96" MaxWidth="640" HorizontalAlignment="Stretch" />
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,16,0">
                        <Button x:Name="TodayRecipeButton" Height="32" Padding="8,0" Click="TodayRecipeClicked" IsEnabled="False"
                                Style="{StaticResource BriefPlainButton}" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="TodayRecipeButton" AutomationProperties.Name="Edit the recipe"
                                ToolTipService.ToolTip="Edit the recipe of this brief">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A5;" FontSize="12" />
                                <TextBlock Text="Recipe" FontSize="13" FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="WriteBriefButton" Width="32" Height="32" Padding="0" Click="WriteBriefClicked"
                                CornerRadius="{StaticResource RadiusControl}" AutomationProperties.AutomationId="WriteBriefButton"
                                AutomationProperties.Name="Write a new brief" AutomationProperties.AcceleratorKey="Ctrl+R"
                                ToolTipService.ToolTip="Write a new brief (Ctrl+R)">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- A recipe, opened in place from the brief it wrote: Edit, Try it and History. Built in MainWindow.Recipe.cs. -->
                <Grid x:Name="RecipePane" Grid.RowSpan="2" Visibility="Collapsed" Background="{ThemeResource GroundBrush}" KeyDown="RecipePaneKeyDown"
                      AutomationProperties.Name="Recipe" AutomationProperties.AutomationId="RecipePane">
                    <Grid.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveRecipeShortcut" />
                    </Grid.KeyboardAccelerators>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,8,16,0" ColumnSpacing="8" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RecipeBack" Click="RecipeBackClicked" Style="{StaticResource BriefQuietAction}"
                                AutomationProperties.AutomationId="RecipeBack">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                <TextBlock x:Name="RecipeBackText" Text="Back" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" x:Name="RecipeBarName" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource MutedBrush}" FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                        <SelectorBar Grid.Column="2" x:Name="RecipeTabs" SelectionChanged="RecipeTabChanged"
                                     AutomationProperties.Name="Recipe pages" AutomationProperties.AutomationId="RecipeTabs">
                            <SelectorBarItem x:Name="RecipeEditTab" Text="Edit" IsSelected="True" />
                            <SelectorBarItem x:Name="RecipeTryTab" Text="Try it" />
                            <SelectorBarItem x:Name="RecipeHistoryTab" Text="History" />
                        </SelectorBar>
                    </Grid>
                    <ScrollViewer Grid.Row="1" x:Name="RecipeScroller" IsTabStop="False"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,40,40,96" MaxWidth="640" HorizontalAlignment="Stretch">
                            <ProgressRing x:Name="RecipeLoading" Width="16" Height="16" HorizontalAlignment="Left" IsActive="False" Visibility="Collapsed" />
                            <StackPanel x:Name="RecipeState" Visibility="Collapsed" />
                            <StackPanel x:Name="RecipeBody" Visibility="Collapsed">
                                <TextBlock x:Name="RecipeTitle" FontSize="34" CharacterSpacing="-15" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           FontFamily="{StaticResource FontReading}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Title, Mode=OneWay}"
                                           Foreground="{ThemeResource InkBrush}" AutomationProperties.HeadingLevel="Level1"
                                           AutomationProperties.AutomationId="RecipeTitle" />
                                <TextBlock x:Name="RecipeSubtitle" FontSize="13" Margin="0,8,0,24" TextWrapping="Wrap"
                                           Foreground="{ThemeResource MutedBrush}" FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                                <StackPanel x:Name="RecipeEditPage">
                                    <Border x:Name="RecipeConflict" Visibility="Collapsed" Padding="16" Margin="0,0,0,16"
                                            Background="{ThemeResource SelectedBrush}" CornerRadius="{StaticResource RadiusPanel}">
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Name="RecipeConflictTitle" FontSize="14" TextWrapping="Wrap" FontFamily="{StaticResource FontUi}"
                                                       FontWeight="{x:Bind local:ReaderFontWeights.Shared.SectionLabel, Mode=OneWay}" Foreground="{ThemeResource InkBrush}" />
                                            <TextBlock x:Name="RecipeConflictDetail" FontSize="13" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource InkSoftBrush}" FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                <Button Content="Keep mine" Click="RecipeKeepMineClicked" Style="{StaticResource BriefPrimaryAction}"
                                                        AutomationProperties.AutomationId="RecipeKeepMine" />
                                                <Button Content="Use the newer one" Click="RecipeTakeTheirsClicked" Style="{StaticResource BriefQuietAction}"
                                                        AutomationProperties.AutomationId="RecipeTakeTheirs" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBox x:Name="RecipeEditor" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="300" Padding="16"
                                             FontSize="13" FontFamily="{StaticResource FontCode}" IsSpellCheckEnabled="False"
                                             CornerRadius="{StaticResource RadiusPanel}" TextChanged="RecipeEditorChanged"
                                             AutomationProperties.Name="Recipe text" AutomationProperties.AutomationId="RecipeEditor" />
                                    <Grid ColumnSpacing="8" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE946;" FontSize="12" Margin="0,3,0,0" VerticalAlignment="Top" Foreground="{ThemeResource MutedBrush}" />
                                        <TextBlock Grid.Column="1" x:Name="RecipeFixedNote" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource InkSoftBrush}" FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8" Margin="0,24,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Ellipse x:Name="RecipeDirtyDot" Style="{StaticResource BriefDot}" Visibility="Collapsed" />
                                            <TextBlock x:Name="RecipeStatus" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                                       Foreground="{ThemeResource MutedBrush}" FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="RecipeReset" Content="Reset to built-in" Click="RecipeResetClicked"
                                                Style="{StaticResource BriefQuietAction}" Visibility="Collapsed" AutomationProperties.AutomationId="RecipeReset" />
                                        <Button Grid.Column="2" x:Name="RecipeRevert" Content="Revert" Click="RecipeRevertClicked" IsEnabled="False"
                                                Style="{StaticResource BriefSecondaryAction}" AutomationProperties.AutomationId="RecipeRevert" />
                                        <Button Grid.Column="3" x:Name="RecipeSave" Content="Save" Click="RecipeSaveClicked" IsEnabled="False"
                                                Style="{StaticResource BriefPrimaryAction}" AutomationProperties.AutomationId="RecipeSave"
                                                AutomationProperties.AcceleratorKey="Ctrl+S" ToolTipService.ToolTip="Save (Ctrl+S)" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel x:Name="RecipeTryPage" Visibility="Collapsed">
                                    <Grid ColumnSpacing="12" Margin="0,0,0,28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RecipeTrialIntro" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource InkSoftBrush}" FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                                        <Button Grid.Column="1" x:Name="RecipeTryButton" Content="Try it" Click="RecipeTryClicked"
                                                Style="{StaticResource BriefPrimaryAction}" AutomationProperties.AutomationId="RecipeTry" />
                                    </Grid>
                                    <StackPanel x:Name="RecipeTrialColumn" />
                                </StackPanel>
                                <StackPanel x:Name="RecipeHistoryPage" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <!-- Ask your feeds: a question answered only from your articles, each claim cited. Built in MainWindow.Ask.cs. -->
                <Grid x:Name="AskPane" Grid.RowSpan="2" Visibility="Collapsed" Background="{ThemeResource GroundBrush}" KeyDown="AskPaneKeyDown"
                      AutomationProperties.Name="Ask your feeds" AutomationProperties.AutomationId="AskPane">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,8,16,0" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AskBack" Click="AskBackClicked" Style="{StaticResource BriefQuietAction}"
                                AutomationProperties.AutomationId="AskBack">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                <TextBlock x:Name="AskBackText" Text="Back" />
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button x:Name="AskCopy" Visibility="Collapsed" Click="AskCopyClicked"
                                    Style="{StaticResource BriefQuietAction}" Content="Copy"
                                    AutomationProperties.Name="Copy the answer" AutomationProperties.AutomationId="AskCopy" />
                            <Button x:Name="AskRoutine" Visibility="Collapsed" Click="AskRoutineClicked"
                                    Style="{StaticResource BriefQuietAction}" Content="Make it a routine"
                                    AutomationProperties.AutomationId="AskRoutine" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" x:Name="AskScroller" IsTabStop="True" UseSystemFocusVisuals="True"
                                  AutomationProperties.Name="Answer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="AskColumn" Margin="40,48,40,96" MaxWidth="640" HorizontalAlignment="Stretch">
                            <Grid x:Name="AskField" ColumnSpacing="8" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AskQuery" FontSize="15" MinHeight="40" VerticalContentAlignment="Center"
                                         KeyDown="AskQueryKeyDown" TextChanged="AskQueryChanged" MaxLength="4000"
                                         AutomationProperties.AutomationId="AskQuery" AutomationProperties.Name="Question"
                                         FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Text="Answers only from your feeds" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource MutedBrush}" FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                                <Button Grid.Column="2" x:Name="AskSubmit" Width="40" Height="40" Padding="0" IsEnabled="False"
                                        Click="AskSubmitClicked" Style="{StaticResource AccentButtonStyle}" CornerRadius="{StaticResource RadiusControl}"
                                        AutomationProperties.Name="Ask" AutomationProperties.AutomationId="AskSubmit" ToolTipService.ToolTip="Ask (Enter)">
                                    <FontIcon Glyph="&#xE74A;" FontSize="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <!-- Routines: the list, then When / Look in / Then for the chosen one, as on macOS
                 (gui/Sources/Reader/Routines.swift). Built in MainWindow.Routines.cs. -->
            <Grid Grid.Column="2" Grid.ColumnSpan="3" x:Name="RoutinesPane" Visibility="Collapsed"
                  Background="{ThemeResource GroundBrush}" KeyDown="RoutinesKeyDown"
                  AutomationProperties.Name="Routines" AutomationProperties.AutomationId="RoutinesPane">
                <Grid.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveRoutineShortcut" />
                </Grid.KeyboardAccelerators>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RoutineListColumn" Width="368" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,16,16,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Routines" FontSize="20" CharacterSpacing="-10" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontUi}" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}"
                                   AutomationProperties.HeadingLevel="Level1" />
                        <Button Grid.Column="1" x:Name="NewRoutineButton" Width="32" Height="32" Padding="0" Click="NewRoutineClicked"
                                CornerRadius="{StaticResource RadiusControl}" AutomationProperties.AutomationId="NewRoutine"
                                AutomationProperties.Name="New routine" ToolTipService.ToolTip="New routine">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Background="{ThemeResource HairlineBrush}" />
                    <ListView Grid.Row="2" x:Name="RoutineRows" Margin="8,8,8,0" SelectionChanged="RoutineRowChanged"
                              AutomationProperties.Name="Routines" AutomationProperties.AutomationId="RoutineList">
                        <ListView.Header>
                            <TextBlock x:Name="RoutinesEmpty" Visibility="Collapsed" Margin="12" FontSize="13" TextWrapping="Wrap"
                                       FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource MutedBrush}"
                                       AutomationProperties.AutomationId="RoutinesEmpty" />
                        </ListView.Header>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
                                <Setter Property="Margin" Value="0,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoutineListItem">
                                <Grid Padding="4,12" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Opacity="{x:Bind NameOpacity}" FontFamily="{StaticResource FontUi}"
                                                   Foreground="{ThemeResource InkBrush}" />
                                        <TextBlock Text="{x:Bind Line}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource InkSoftBrush}" />
                                        <TextBlock Text="{x:Bind Status}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource MutedBrush}" />
                                    </StackPanel>
                                    <!-- Toggles without choosing the row. -->
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Enabled}" Visibility="{x:Bind CanToggle}"
                                                  OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Top"
                                                  Toggled="RoutineEnabledToggled" AutomationProperties.Name="{x:Bind ToggleName}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <Border Grid.Column="1" Background="{ThemeResource HairlineBrush}" />
                <Grid Grid.Column="2">
                    <ScrollViewer x:Name="RoutineScroller" IsTabStop="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,64,40,96" MaxWidth="640" HorizontalAlignment="Stretch">
                            <!-- Nothing chosen, or no routines yet. -->
                            <StackPanel x:Name="RoutineNone" Visibility="Collapsed" Margin="0,32,0,0" />
                            <StackPanel x:Name="RoutineEditor" Visibility="Collapsed">
                                <Button x:Name="RoutineTitleButton" Click="RenameRoutineClicked" Padding="0" Background="Transparent" BorderThickness="0"
                                        HorizontalAlignment="Left" ToolTipService.ToolTip="Rename" AutomationProperties.AutomationId="RoutineTitle"
                                        AutomationProperties.HelpText="Rename the routine">
                                    <TextBlock x:Name="RoutineTitle" FontSize="34" CharacterSpacing="-15" TextWrapping="Wrap"
                                               FontFamily="{StaticResource FontReading}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Title, Mode=OneWay}"
                                               Foreground="{ThemeResource InkBrush}" />
                                </Button>
                                <TextBox x:Name="RoutineNameBox" Visibility="Collapsed" FontSize="28" MaxLength="200"
                                         FontFamily="{StaticResource FontReading}" KeyDown="RoutineNameKeyDown" LostFocus="RoutineNameLostFocus"
                                         PlaceholderText="Routine name" AutomationProperties.Name="Routine name"
                                         AutomationProperties.AutomationId="RoutineNameBox" />
                                <TextBlock x:Name="RoutineBackground" FontSize="13" Margin="0,8,0,24" TextWrapping="Wrap"
                                           FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource MutedBrush}" />
                                <Border BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}">
                                    <StackPanel>
                                        <Grid Padding="16,12" ColumnSpacing="0" AutomationProperties.Name="When">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="When" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource InkSoftBrush}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <ComboBox x:Name="RoutineRepeat" MinWidth="168" SelectionChanged="RoutineRepeatChanged"
                                                          AutomationProperties.Name="Repeat" AutomationProperties.AutomationId="RoutineRepeat" />
                                                <TextBlock x:Name="RoutineAt" Text="at" FontSize="13" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource MutedBrush}" />
                                                <ComboBox x:Name="RoutineTime" MinWidth="96" MaxDropDownHeight="320" SelectionChanged="RoutineTimeChanged"
                                                          AutomationProperties.Name="Time" AutomationProperties.AutomationId="RoutineTime" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                                        <Grid Padding="16,12" AutomationProperties.Name="Look in">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Look in" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource InkSoftBrush}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <ComboBox x:Name="RoutineView" MinWidth="168" PlaceholderText="Choose a view" SelectionChanged="RoutineViewChanged"
                                                          AutomationProperties.Name="View" AutomationProperties.AutomationId="RoutineView" />
                                                <TextBlock x:Name="RoutineLookIn" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                                                           FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource MutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                                        <Grid Padding="16,12" AutomationProperties.Name="Then">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Then" FontSize="13" FontWeight="Medium" Margin="0,10,0,0"
                                                       FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource InkSoftBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <StackPanel x:Name="RoutineActions" Spacing="4" />
                                                <DropDownButton x:Name="AddRoutineAction" Style="{StaticResource BriefQuietAction}" Margin="-10,0,0,0"
                                                                AutomationProperties.AutomationId="AddRoutineAction" AutomationProperties.Name="Add action">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                                                        <TextBlock Text="Add action" />
                                                    </StackPanel>
                                                    <DropDownButton.Flyout>
                                                        <MenuFlyout x:Name="AddRoutineActionMenu" Placement="BottomEdgeAlignedLeft" />
                                                    </DropDownButton.Flyout>
                                                </DropDownButton>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Grid Margin="0,36,0,0" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="8" VerticalAlignment="Bottom">
                                        <TextBlock Text="DRY RUN · LAST WEEK" FontSize="11" CharacterSpacing="60"
                                                   FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.SectionLabel, Mode=OneWay}"
                                                   Foreground="{ThemeResource MutedBrush}" AutomationProperties.HeadingLevel="Level2" />
                                        <ProgressRing x:Name="RoutineDryRunLoading" Width="12" Height="12" HorizontalAlignment="Left" IsActive="False" Visibility="Collapsed" />
                                        <TextBlock x:Name="RoutineDryRunSummary" FontSize="19" TextWrapping="Wrap" FontFamily="{StaticResource FontReading}"
                                                   Foreground="{ThemeResource InkBrush}" AutomationProperties.AutomationId="RoutineDryRun"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <StackPanel x:Name="RoutineDryRunActions" Spacing="2" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" x:Name="RoutineDryRunBars" Orientation="Horizontal" Spacing="8"
                                                Height="60" VerticalAlignment="Bottom" />
                                </Grid>
                                <Border Height="1" Margin="0,24,0,0" Background="{ThemeResource HairlineBrush}" />
                                <Grid Margin="0,16,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RoutineFooter" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                               FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource MutedBrush}"
                                               AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="RoutineFooter" />
                                    <Button Grid.Column="1" x:Name="RunRoutine" Content="Run now" Click="RunRoutineClicked"
                                            Style="{StaticResource BriefSecondaryAction}" AutomationProperties.AutomationId="RunRoutine" />
                                    <Button Grid.Column="2" x:Name="SaveRoutine" Content="Save" Click="SaveRoutineClicked" IsEnabled="False"
                                            Style="{StaticResource BriefPrimaryAction}" AutomationProperties.AutomationId="SaveRoutine"
                                            AutomationProperties.AcceleratorKey="Ctrl+S" ToolTipService.ToolTip="Save (Ctrl+S)" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="RemoveRoutine" Content="Remove" Click="RemoveRoutineClicked" Visibility="Collapsed"
                            Style="{StaticResource BriefQuietAction}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0"
                            AutomationProperties.Name="Remove routine" AutomationProperties.AutomationId="RemoveRoutine" />
                </Grid>
            </Grid>
            <Grid Grid.Column="2" Grid.ColumnSpan="3" x:Name="SettingsPane" Visibility="Collapsed"
                  Background="{ThemeResource GroundBrush}" AutomationProperties.Name="Settings">
                <Grid.Resources>
                    <Style x:Key="SettingsTitle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="20" />
                        <Setter Property="FontFamily" Value="{StaticResource FontReading}" />
                        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                    <Style x:Key="SettingsLabel" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
                        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                    <Style x:Key="SettingsDetail" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                    <Style x:Key="SettingsAction" TargetType="Button">
                        <Setter Property="Height" Value="32" />
                        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
                        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
                    </Style>
                    <Style x:Key="SettingsPicker" TargetType="ComboBox">
                        <Setter Property="MinWidth" Value="152" />
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="24,16,24,8">
                    <SelectorBar x:Name="SettingsTabs" HorizontalAlignment="Center"
                                 AutomationProperties.Name="Settings tabs" FontFamily="{StaticResource FontUi}">
                        <SelectorBarItem x:Name="GeneralSettingsTab" Text="General" AutomationProperties.AutomationId="GeneralSettingsTab">
                            <SelectorBarItem.Icon><SymbolIcon Symbol="Setting" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="ReadingSettingsTab" Text="Reading" AutomationProperties.AutomationId="ReadingSettingsTab">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE8D2;" FontSize="14" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="AgentsSettingsTab" Text="Agents" AutomationProperties.AutomationId="AgentsSettingsTab">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE99A;" FontSize="14" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>
                    <Button x:Name="CloseSettingsButton" HorizontalAlignment="Right" Width="32" Height="32" Padding="0"
                            Click="CloseSettingsClicked" CornerRadius="{StaticResource RadiusControl}" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="CloseSettingsButton" AutomationProperties.Name="Close Settings"
                            ToolTipService.ToolTip="Close Settings (Esc)">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </Grid>
                <Grid Grid.Row="1" Padding="24,0">
                    <StackPanel Spacing="8" x:Name="SettingsFeedback" Visibility="Collapsed" MaxWidth="640" Margin="0,8">
                        <TextBlock x:Name="SettingsStatus" Style="{StaticResource SettingsDetail}" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="ReloadSettingsButton" Visibility="Collapsed" Content="Try again" Click="ReloadSettingsClicked"
                                Style="{StaticResource SettingsAction}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="2" x:Name="SettingsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              AutomationProperties.AutomationId="SettingsScroll">
                    <Grid Padding="24,16,24,28">
                        <StackPanel x:Name="GeneralSettingsBody" MaxWidth="640" Spacing="24">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Updates" Style="{StaticResource SettingsTitle}" AutomationProperties.HeadingLevel="Level2" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Check for new articles" Style="{StaticResource SettingsLabel}" />
                                        <TextBlock Text="Fyke follows how often each feed posts." Style="{StaticResource SettingsDetail}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Automatic" VerticalAlignment="Center" Style="{StaticResource SettingsDetail}" />
                                </Grid>
                                <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Fetch full articles" Style="{StaticResource SettingsLabel}" />
                                        <TextBlock Text="Replaces short summaries and follows each site’s robots.txt." Style="{StaticResource SettingsDetail}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="FullTextToggle" Toggled="GeneralSettingToggled" IsEnabled="False"
                                                  MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="Fetch full articles"
                                                  AutomationProperties.AutomationId="FullTextToggle" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Privacy" Style="{StaticResource SettingsTitle}" AutomationProperties.HeadingLevel="Level2" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Load images automatically" Style="{StaticResource SettingsLabel}" />
                                        <TextBlock Text="Loading an image can tell its publisher you are reading." Style="{StaticResource SettingsDetail}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="LoadImagesToggle" Toggled="GeneralSettingToggled" IsEnabled="False"
                                                  MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="Load images automatically"
                                                  AutomationProperties.AutomationId="LoadImagesToggle" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Subscriptions and keys" Style="{StaticResource SettingsTitle}" AutomationProperties.HeadingLevel="Level2" />
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Your subscriptions" Style="{StaticResource SettingsLabel}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SettingsImport" Content="Import OPML…" Click="ImportOpmlClicked" Style="{StaticResource SettingsAction}" />
                                        <Button x:Name="SettingsExport" Content="Export OPML…" Click="SettingsExportClicked" Style="{StaticResource SettingsAction}" />
                                    </StackPanel>
                                </StackPanel>
                                <Expander Header="Keyboard shortcuts" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          FontFamily="{StaticResource FontUi}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource SettingsLabel}">Command palette <Run Text="Ctrl+K" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Search articles <Run Text="Ctrl+F or /" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Add feed <Run Text="Ctrl+N or A" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Settings <Run Text="Ctrl+," Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Move between panes <Run Text="F6 / Shift+F6" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Next or previous article <Run Text="J / K" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Next unread article <Run Text="N" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Show unread only or all articles <Run Text="U" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Open page in browser <Run Text="O" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Fetch full article <Run Text="F" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Text size and spacing <Run Text="T" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Refresh feeds <Run Text="R" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Mark read or unread <Run Text="M" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Star or unstar article <Run Text="S" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Show discussion <Run Text="C" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Mark all read <Run Text="Ctrl+Shift+K" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Undo mark all read <Run Text="Ctrl+Z" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Close panel <Run Text="Esc" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="ReadingSettingsBody" MaxWidth="640" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="Appearance" Style="{StaticResource SettingsTitle}" AutomationProperties.HeadingLevel="Level2" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Fixed theme" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="ThemePicker" Style="{StaticResource SettingsPicker}" IsEnabled="False"
                                          SelectionChanged="AppearanceThemeChanged" AutomationProperties.Name="Fixed theme"
                                          AutomationProperties.AutomationId="ThemePicker" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Follow system appearance" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" x:Name="FollowSystemToggle" Toggled="FollowSystemChanged" IsEnabled="False"
                                              MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="Follow system appearance"
                                              AutomationProperties.AutomationId="FollowSystemToggle" />
                            </Grid>
                            <StackPanel x:Name="SystemThemeChoices" Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Day" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" x:Name="DayThemePicker" Style="{StaticResource SettingsPicker}" IsEnabled="False"
                                              SelectionChanged="AppearanceThemeChanged" AutomationProperties.Name="Day theme" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Night" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" x:Name="NightThemePicker" Style="{StaticResource SettingsPicker}" IsEnabled="False"
                                              SelectionChanged="AppearanceThemeChanged" AutomationProperties.Name="Night theme" />
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="Font weights" Style="{StaticResource SettingsTitle}" Margin="0,16,0,0"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Reading" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontReading}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Reading, Mode=OneWay}" />
                                <ComboBox Grid.Column="1" x:Name="ReadingWeightPicker" Style="{StaticResource SettingsPicker}" IsEnabled="False"
                                          SelectionChanged="FontWeightChanged" AutomationProperties.Name="Reading font weight"
                                          AutomationProperties.AutomationId="ReadingWeightPicker" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Titles" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontReading}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Title, Mode=OneWay}" />
                                <ComboBox Grid.Column="1" x:Name="TitleWeightPicker" Style="{StaticResource SettingsPicker}" IsEnabled="False"
                                          SelectionChanged="FontWeightChanged" AutomationProperties.Name="Titles font weight"
                                          AutomationProperties.AutomationId="TitleWeightPicker" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="App" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                                <ComboBox Grid.Column="1" x:Name="UiWeightPicker" Style="{StaticResource SettingsPicker}" IsEnabled="False"
                                          SelectionChanged="FontWeightChanged" AutomationProperties.Name="App font weight"
                                          AutomationProperties.AutomationId="UiWeightPicker" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Code" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontCode}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Code, Mode=OneWay}" />
                                <ComboBox Grid.Column="1" x:Name="CodeWeightPicker" Style="{StaticResource SettingsPicker}" IsEnabled="False"
                                          SelectionChanged="FontWeightChanged" AutomationProperties.Name="Code font weight"
                                          AutomationProperties.AutomationId="CodeWeightPicker" />
                            </Grid>
                            <TextBlock Text="Text" Style="{StaticResource SettingsTitle}" Margin="0,16,0,0"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" MinWidth="80" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Text size" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" x:Name="TextSizeSlider" MaxWidth="200" HorizontalAlignment="Stretch"
                                        IsEnabled="False" ValueChanged="TextLayoutChanged" AutomationProperties.Name="Text size"
                                        AutomationProperties.AutomationId="TextSizeSlider" />
                                <TextBlock Grid.Column="2" x:Name="TextSizeValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Style="{StaticResource SettingsDetail}" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" MinWidth="80" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Line spacing" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" x:Name="LineSpacingSlider" MaxWidth="200" HorizontalAlignment="Stretch"
                                        IsEnabled="False" ValueChanged="TextLayoutChanged" AutomationProperties.Name="Line spacing"
                                        AutomationProperties.AutomationId="LineSpacingSlider" />
                                <TextBlock Grid.Column="2" x:Name="LineSpacingValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Style="{StaticResource SettingsDetail}" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" MinWidth="80" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Column width" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" x:Name="ColumnWidthSlider" MaxWidth="200" HorizontalAlignment="Stretch"
                                        IsEnabled="False" ValueChanged="TextLayoutChanged" AutomationProperties.Name="Column width"
                                        AutomationProperties.AutomationId="ColumnWidthSlider" />
                                <TextBlock Grid.Column="2" x:Name="ColumnWidthValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Style="{StaticResource SettingsDetail}" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Show scrollbars" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="ScrollbarsPicker" Style="{StaticResource SettingsPicker}" IsEnabled="False"
                                          SelectionChanged="ScrollbarsChanged" AutomationProperties.Name="Show scrollbars"
                                          AutomationProperties.AutomationId="ScrollbarsPicker" />
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="AgentsSettingsBody" MaxWidth="640" Spacing="24" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Who writes your briefs" Style="{StaticResource SettingsTitle}" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock x:Name="WritersDetail" Style="{StaticResource SettingsDetail}" />
                                <TextBlock x:Name="WritersEmpty" Style="{StaticResource SettingsDetail}" FontSize="13" Margin="0,12" />
                                <StackPanel x:Name="WriterRows" AutomationProperties.Name="Writers" />
                                <TextBlock x:Name="WritersProblem" Style="{StaticResource SettingsLabel}" FontSize="12" Visibility="Collapsed"
                                           AutomationProperties.AutomationId="WritersProblem" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Let agents use Fyke" Style="{StaticResource SettingsTitle}" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock x:Name="AgentsDetail" Style="{StaticResource SettingsDetail}" />
                                <Grid ColumnSpacing="12" MinHeight="40">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Read articles, views and briefs" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Always on" Style="{StaticResource SettingsDetail}" FontSize="13" VerticalAlignment="Center" />
                                </Grid>
                                <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Make changes" Style="{StaticResource SettingsLabel}" />
                                        <TextBlock Text="Mark read and star; or also edit views, recipes and routines" Style="{StaticResource SettingsDetail}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="AgentTierPicker" Style="{StaticResource SettingsPicker}" MinWidth="180" IsEnabled="False"
                                              SelectionChanged="AgentTierChanged" AutomationProperties.Name="What agents may change"
                                              AutomationProperties.AutomationId="AgentTierPicker" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnSpacing="12" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Add Fyke to another agent with this configuration." Style="{StaticResource SettingsDetail}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="CopyMcpConfig" Content="Copy MCP config" Click="CopyMcpConfigClicked"
                                            Style="{StaticResource SettingsAction}" AutomationProperties.AutomationId="CopyMcpConfig" />
                                </Grid>
                                <Border Padding="16,12" CornerRadius="{StaticResource RadiusControl}" Background="{ThemeResource SurfaceBrush}">
                                    <TextBlock x:Name="McpConfigText" FontFamily="{StaticResource FontCode}" FontSize="12" IsTextSelectionEnabled="True"
                                               TextWrapping="Wrap" Foreground="{ThemeResource InkSoftBrush}" AutomationProperties.Name="MCP configuration" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12" MaxWidth="400"
                    x:Name="InlineState">
            <TextBlock x:Name="MessageText" AutomationProperties.AutomationId="ConnectionMessage" Text="{x:Bind ViewModel.Message, Mode=OneWay}" FontSize="20" TextWrapping="Wrap"
                       Foreground="{ThemeResource InkBrush}" />
            <TextBlock x:Name="DetailText" Text="{x:Bind ViewModel.Detail, Mode=OneWay}" TextWrapping="Wrap"
                       Foreground="{ThemeResource InkSoftBrush}" />
            <Button x:Name="RetryButton" AutomationProperties.AutomationId="ConnectionRetry" Content="Try again" Command="{x:Bind ViewModel.RetryCommand}" Height="32"
                    CornerRadius="{StaticResource RadiusControl}" />
        </StackPanel>
        <Border Grid.Row="1" x:Name="BulkNotice" Visibility="Collapsed" MaxWidth="480" Margin="16"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="16,8,8,8"
                Background="{ThemeResource InkBrush}" CornerRadius="{StaticResource RadiusPanel}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BulkNoticeText" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                           Foreground="{ThemeResource GroundBrush}" AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="1" x:Name="BulkNoticeUndo" Content="Undo" Height="32" VerticalAlignment="Center"
                        Click="UndoBulkClicked" CornerRadius="{StaticResource RadiusControl}"
                        AutomationProperties.AutomationId="BulkNoticeUndo" AutomationProperties.AcceleratorKey="Ctrl+Z"
                        ToolTipService.ToolTip="Undo (Ctrl+Z)"
                        FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
            </Grid>
        </Border>
        <Grid Grid.RowSpan="2" x:Name="SearchOverlay" Visibility="Collapsed" TabFocusNavigation="Cycle">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveSearchViewShortcut" />
            </Grid.KeyboardAccelerators>
            <Border Background="{ThemeResource ScrimBrush}" PointerPressed="SearchBackdropPressed" />
            <Border MaxWidth="640" Margin="16,96,16,16" VerticalAlignment="Top"
                    CornerRadius="{StaticResource RadiusSheet}" BorderThickness="1"
                    BorderBrush="{ThemeResource HairlineBrush}" Background="{ThemeResource SurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,16,20,16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchQuery" PlaceholderText="Search your feeds" FontSize="20"
                                 FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                 TextChanged="SearchQueryChanged" AutomationProperties.Name="Search your feeds"
                                 AutomationProperties.AutomationId="SearchQuery" />
                        <TextBlock Grid.Column="1" x:Name="SearchCount" FontSize="13" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                   Foreground="{ThemeResource MutedBrush}" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <Border Grid.Row="1" BorderThickness="0,1,0,1" BorderBrush="{ThemeResource HairlineBrush}">
                        <Grid>
                            <StackPanel x:Name="SearchState" Margin="20,16" Spacing="8">
                                <TextBlock x:Name="SearchStatus" TextWrapping="Wrap" FontSize="14"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                           Foreground="{ThemeResource InkSoftBrush}" AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="RetrySearch" Content="Try again" Height="32" Click="RetrySearchClicked"
                                        FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                        Visibility="Collapsed" CornerRadius="{StaticResource RadiusControl}" />
                            </StackPanel>
                            <ListView x:Name="SearchResults" Margin="8" MaxHeight="512" Visibility="Collapsed"
                                      AutomationProperties.Name="Search results" AutomationProperties.AutomationId="SearchResults">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SearchHit">
                                        <Button Height="64" Padding="12,8" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                                CornerRadius="{StaticResource RadiusControl}" Click="SearchResultClicked"
                                                AutomationProperties.Name="{x:Bind AccessibleName}">
                                            <Grid ColumnSpacing="20">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="104" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"
                                                               FontSize="18" FontFamily="{StaticResource FontReading}"
                                                               FontWeight="{x:Bind local:ReaderFontWeights.Shared.TimelineTitle, Mode=OneWay}"
                                                               DataContextChanged="PrepareSearchTitle" />
                                                    <TextBlock TextTrimming="CharacterEllipsis" FontSize="13"
                                                               FontFamily="{StaticResource FontUi}"
                                                               FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                                               Foreground="{ThemeResource InkSoftBrush}"
                                                               DataContextChanged="PrepareSearchSnippet" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="3" Margin="0,4,0,0">
                                                    <TextBlock Text="{x:Bind FeedTitle}" TextTrimming="CharacterEllipsis"
                                                               TextAlignment="Right" FontSize="13" FontFamily="{StaticResource FontUi}"
                                                               FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                                               Foreground="{ThemeResource MutedBrush}" />
                                                    <TextBlock TextAlignment="Right" FontSize="13" FontFamily="{StaticResource FontUi}"
                                                               Foreground="{ThemeResource MutedBrush}"
                                                               DataContextChanged="PrepareSearchDate" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="20,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="SearchUnread" Content="All articles" Height="32"
                                      Checked="SearchUnreadChanged" Unchecked="SearchUnreadChanged"
                                      FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                      CornerRadius="{StaticResource RadiusControl}" AutomationProperties.Name="Unread only"
                                      AutomationProperties.AutomationId="SearchUnread" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SaveSearchViewButton" Content="Save view…" Height="32" IsEnabled="False"
                                    Click="SaveSearchViewClicked" CornerRadius="{StaticResource RadiusControl}"
                                    FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                    AutomationProperties.AutomationId="SaveSearchViewButton" AutomationProperties.AcceleratorKey="Ctrl+S"
                                    ToolTipService.ToolTip="Save view (Ctrl+S)" />
                            <Button Content="Close" Height="32" Click="CloseSearchClicked"
                                    FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                    CornerRadius="{StaticResource RadiusControl}" AutomationProperties.AcceleratorKey="Esc" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="2" x:Name="PaletteOverlay" Visibility="Collapsed" TabFocusNavigation="Cycle">
            <Border Background="{ThemeResource ScrimBrush}" PointerPressed="PaletteBackdropPressed" />
            <Border MaxWidth="620" Margin="16,120,16,16" VerticalAlignment="Top"
                    CornerRadius="{StaticResource RadiusSheet}" BorderThickness="1"
                    BorderBrush="{ThemeResource HairlineBrush}" Background="{ThemeResource SurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PaletteQuery" PlaceholderText="Go to, do, or find…" FontSize="18"
                                 FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                 TextChanged="PaletteQueryChanged" AutomationProperties.Name="Command palette"
                                 AutomationProperties.AutomationId="PaletteQuery" />
                        <Button Grid.Column="1" Content="Close" Height="32" VerticalAlignment="Center" Click="ClosePaletteClicked"
                                FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                CornerRadius="{StaticResource RadiusControl}" AutomationProperties.AcceleratorKey="Esc" />
                    </Grid>
                    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource HairlineBrush}">
                        <Grid>
                            <TextBlock x:Name="PaletteStatus" Margin="20,16" TextWrapping="Wrap" FontSize="14"
                                       FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                       Foreground="{ThemeResource InkSoftBrush}" AutomationProperties.LiveSetting="Polite" />
                            <ListView x:Name="PaletteResults" Margin="8" MaxHeight="420"
                                      AutomationProperties.Name="Commands and articles" AutomationProperties.AutomationId="PaletteResults">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:PaletteResult">
                                        <Button Height="36" Padding="12,4" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                                CornerRadius="{StaticResource RadiusControl}" Click="PaletteResultClicked"
                                                AutomationProperties.Name="{x:Bind Title}" AutomationProperties.AcceleratorKey="{x:Bind Shortcut}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" MaxWidth="140" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                                           Foreground="{ThemeResource InkBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis"
                                                           FontSize="12" VerticalAlignment="Center" FontFamily="{StaticResource FontUi}"
                                                           FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" Foreground="{ThemeResource MutedBrush}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Shortcut}" FontSize="12" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                                           Foreground="{ThemeResource MutedBrush}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="2" x:Name="AddFeedOverlay" Visibility="Collapsed" TabFocusNavigation="Cycle">
            <Border Background="{ThemeResource ScrimBrush}" PointerPressed="AddFeedBackdropPressed" />
            <Border MaxWidth="560" Margin="16,96,16,16" VerticalAlignment="Top"
                    CornerRadius="{StaticResource RadiusSheet}" BorderThickness="1"
                    BorderBrush="{ThemeResource HairlineBrush}" Background="{ThemeResource SurfaceBrush}">
                <Grid Padding="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Add a feed" FontSize="26" Margin="0,0,0,16"
                               FontFamily="{StaticResource FontReading}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Title, Mode=OneWay}"
                               Foreground="{ThemeResource InkBrush}" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBox x:Name="AddFeedAddress" PlaceholderText="Site or feed address" MinHeight="38"
                                     FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                     TextChanged="AddFeedAddressChanged" AutomationProperties.Name="Site or feed address"
                                     AutomationProperties.AutomationId="AddFeedAddress" />
                            <TextBlock x:Name="AddFeedStatus" TextWrapping="Wrap" FontSize="13"
                                       FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                       Foreground="{ThemeResource InkSoftBrush}" AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="AddFeedLocalRetry" Content="Find feeds on the local network" Visibility="Collapsed"
                                    Height="32" Click="AddFeedLocalClicked" CornerRadius="{StaticResource RadiusControl}"
                                    AutomationProperties.AutomationId="AddFeedLocalRetry"
                                    FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                            <StackPanel x:Name="AddFeedOptions" Spacing="12" Visibility="Collapsed">
                                <ListView x:Name="AddFeedCandidates" SelectionMode="Multiple" MaxHeight="240"
                                          SelectionChanged="AddFeedSelectionChanged" AutomationProperties.Name="Discovered feeds"
                                          AutomationProperties.AutomationId="AddFeedCandidates">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FeedCandidate">
                                            <StackPanel Spacing="4" Padding="4,8" AutomationProperties.Name="{x:Bind DisplayTitle}">
                                                <TextBlock Text="{x:Bind DisplayTitle}" FontSize="15" TextTrimming="CharacterEllipsis"
                                                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.SectionLabel, Mode=OneWay}"
                                                           Foreground="{ThemeResource InkBrush}" />
                                                <TextBlock Text="{x:Bind Url}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource MutedBrush}" />
                                                <ItemsControl ItemsSource="{x:Bind Latest}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{x:Bind}" FontSize="15" TextTrimming="CharacterEllipsis"
                                                                       FontFamily="{StaticResource FontReading}"
                                                                       FontWeight="{x:Bind local:ReaderFontWeights.Shared.Reading, Mode=OneWay}"
                                                                       Foreground="{ThemeResource UnreadBrush}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Grid x:Name="AddFeedNameRow" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Name" VerticalAlignment="Center" FontFamily="{StaticResource FontUi}"
                                               Foreground="{ThemeResource InkSoftBrush}" />
                                    <TextBox Grid.Column="1" x:Name="AddFeedName" MinHeight="32"
                                             FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                             AutomationProperties.Name="Feed name" AutomationProperties.AutomationId="AddFeedName" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Folder" VerticalAlignment="Center" FontFamily="{StaticResource FontUi}"
                                               Foreground="{ThemeResource InkSoftBrush}" />
                                    <ComboBox Grid.Column="1" x:Name="AddFeedFolder" ItemTemplate="{StaticResource FolderChoiceTemplate}" MinHeight="32"
                                              HorizontalAlignment="Stretch" FontFamily="{StaticResource FontUi}"
                                              FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                              AutomationProperties.Name="Folder" AutomationProperties.AutomationId="AddFeedFolder" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnSpacing="12" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AddFeedImport" Content="Import OPML…" Height="32" Click="ImportOpmlClicked"
                                CornerRadius="{StaticResource RadiusControl}" FontFamily="{StaticResource FontUi}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CancelAddFeed" Content="Cancel" Height="32" Click="AddFeedCancelClicked"
                                    CornerRadius="{StaticResource RadiusControl}" FontFamily="{StaticResource FontUi}" />
                            <Button x:Name="AddFeedPrimary" Content="Find feeds" Height="32" Click="AddFeedPrimaryClicked"
                                    Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="AddFeedPrimary"
                                    CornerRadius="{StaticResource RadiusControl}" FontFamily="{StaticResource FontUi}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="2" x:Name="CatalogEditOverlay" Visibility="Collapsed" TabFocusNavigation="Cycle">
            <Border Background="{ThemeResource ScrimBrush}" PointerPressed="CatalogEditBackdropPressed" />
            <Border MaxWidth="420" Margin="16,120,16,16" VerticalAlignment="Top" Padding="24"
                    CornerRadius="{StaticResource RadiusSheet}" BorderThickness="1"
                    BorderBrush="{ThemeResource HairlineBrush}" Background="{ThemeResource SurfaceBrush}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="CatalogEditHeading" FontSize="24" TextWrapping="Wrap"
                               FontFamily="{StaticResource FontReading}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Title, Mode=OneWay}"
                               Foreground="{ThemeResource InkBrush}" />
                    <TextBox x:Name="CatalogEditName" PlaceholderText="Name" MinHeight="32" TextChanged="CatalogEditNameChanged"
                             FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                             AutomationProperties.Name="Name" AutomationProperties.AutomationId="CatalogEditName" />
                    <ComboBox x:Name="CatalogMoveTarget" ItemTemplate="{StaticResource FolderChoiceTemplate}" HorizontalAlignment="Stretch" MinHeight="32"
                              FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                              SelectionChanged="CatalogEditTargetChanged" AutomationProperties.Name="Destination folder"
                              AutomationProperties.AutomationId="CatalogMoveTarget" />
                    <TextBlock x:Name="CatalogEditHint" FontSize="13" TextWrapping="Wrap"
                               FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                               Foreground="{ThemeResource MutedBrush}" />
                    <CheckBox x:Name="CatalogDeleteContents" Content="Also delete everything inside" Visibility="Collapsed"
                              Checked="CatalogDeleteContentsChanged" Unchecked="CatalogDeleteContentsChanged"
                              FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                              AutomationProperties.AutomationId="CatalogDeleteContents" />
                    <TextBlock x:Name="CatalogEditStatus" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                               FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                               Foreground="{ThemeResource InkSoftBrush}" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="CatalogEditCancel" Content="Cancel" Height="32" Click="CatalogEditCancelClicked"
                                AutomationProperties.AutomationId="CatalogEditCancel"
                                FontFamily="{StaticResource FontUi}" CornerRadius="{StaticResource RadiusControl}" />
                        <Button x:Name="CatalogEditConfirm" Height="32" Click="CatalogEditConfirmClicked"
                                Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="CatalogEditConfirm"
                                FontFamily="{StaticResource FontUi}" CornerRadius="{StaticResource RadiusControl}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Catch up: unread articles one at a time. Skip (Left) marks read, Later (Down) saves for later,
             Read now (Right or Enter) opens it. Built in MainWindow.CatchUp.cs. -->
        <Grid Grid.RowSpan="2" x:Name="CatchUpOverlay" Visibility="Collapsed" Background="{ThemeResource SurfaceBrush}"
              KeyDown="CatchUpKeyDown" TabFocusNavigation="Cycle" AutomationProperties.AutomationId="CatchUp">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="16,40,16,0">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock x:Name="CatchUpHeading" FontSize="13" HorizontalAlignment="Center" FontFamily="{StaticResource FontUi}"
                               FontWeight="{x:Bind local:ReaderFontWeights.Shared.SectionLabel, Mode=OneWay}"
                               AutomationProperties.HeadingLevel="Level1" />
                    <ProgressBar x:Name="CatchUpProgress" Width="200" Maximum="1" AutomationProperties.Name="Catch up progress" />
                </StackPanel>
                <Button x:Name="CatchUpDone" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CatchUpDoneClicked"
                        Style="{StaticResource BriefSecondaryAction}" AutomationProperties.AutomationId="CatchUpDone"
                        AutomationProperties.Name="Done" AutomationProperties.AcceleratorKey="Escape">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Done" />
                        <TextBlock Text="Esc" Foreground="{ThemeResource MutedBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" MaxWidth="680" Margin="16,24" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <ProgressRing x:Name="CatchUpLoading" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                <StackPanel x:Name="CatchUpState" Visibility="Collapsed" HorizontalAlignment="Center" />
                <Grid x:Name="CatchUpStack" Height="420" Visibility="Collapsed">
                    <!-- The edges of the next articles, so the stack reads as a stack. -->
                    <Border x:Name="CatchUpEdgeFar" Style="{StaticResource CatchUpSheet}" Height="40" Margin="32,380,32,0" VerticalAlignment="Top" />
                    <Border x:Name="CatchUpEdgeNear" Style="{StaticResource CatchUpSheet}" Height="40" Margin="16,368,16,0" VerticalAlignment="Top" />
                    <ContentControl x:Name="CatchUpCard" Height="396" VerticalAlignment="Top" IsTabStop="True" UseSystemFocusVisuals="False"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    AutomationProperties.AutomationId="CatchUpCard">
                        <Border Style="{StaticResource CatchUpSheet}" Padding="48">
                            <StackPanel>
                                <TextBlock x:Name="CatchUpDetail" FontSize="12" Margin="0,0,0,16" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource MutedBrush}" FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                                <TextBlock x:Name="CatchUpTitle" FontSize="32" Margin="0,0,0,20" TextWrapping="Wrap" MaxLines="3"
                                           TextTrimming="WordEllipsis" CharacterSpacing="-12" FontFamily="{StaticResource FontReading}"
                                           FontWeight="{x:Bind local:ReaderFontWeights.Shared.Title, Mode=OneWay}"
                                           Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="CatchUpPreview" FontSize="17" LineHeight="28" LineStackingStrategy="BlockLineHeight"
                                           TextWrapping="Wrap" MaxLines="5" TextTrimming="WordEllipsis" FontFamily="{StaticResource FontReading}"
                                           FontWeight="{x:Bind local:ReaderFontWeights.Shared.Reading, Mode=OneWay}"
                                           Foreground="{ThemeResource InkSoftBrush}" />
                            </StackPanel>
                        </Border>
                    </ContentControl>
                </Grid>
                <Grid x:Name="CatchUpActions" ColumnSpacing="12" Margin="0,28,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CatchUpSkip" Click="CatchUpSkipClicked" Style="{StaticResource CatchUpAction}"
                            AutomationProperties.Name="Skip" AutomationProperties.HelpText="Marks it read. Shortcut Left" AutomationProperties.AutomationId="CatchUpSkip">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="13" />
                            <TextBlock Text="Skip" FontSize="16" />
                            <TextBlock Text="&#x2190;" FontSize="13" Foreground="{ThemeResource MutedBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" x:Name="CatchUpLater" Click="CatchUpLaterClicked" Style="{StaticResource CatchUpAction}"
                            AutomationProperties.Name="Later" AutomationProperties.HelpText="Saves it for later. Shortcut Down" AutomationProperties.AutomationId="CatchUpLater">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE823;" FontSize="13" />
                            <TextBlock Text="Later" FontSize="16" />
                            <TextBlock Text="&#x2193;" FontSize="13" Foreground="{ThemeResource MutedBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" x:Name="CatchUpRead" Click="CatchUpReadClicked" Style="{StaticResource CatchUpPrimaryAction}"
                            AutomationProperties.Name="Read now" AutomationProperties.HelpText="Opens it. Shortcut Right" AutomationProperties.AutomationId="CatchUpRead">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="13" />
                            <TextBlock Text="Read now" FontSize="16" />
                            <TextBlock Text="&#x2192;" FontSize="13" Opacity="0.7" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="2" x:Name="CatchUpFooter" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12"
                        Height="32" Margin="16,0,16,32" Visibility="Collapsed">
                <TextBlock x:Name="CatchUpCounts" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource MutedBrush}"
                           AutomationProperties.LiveSetting="Polite" FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                <Button x:Name="CatchUpUndo" Click="CatchUpUndoClicked" Style="{StaticResource BriefQuietAction}"
                        AutomationProperties.Name="Undo last" AutomationProperties.AcceleratorKey="Ctrl+Z"
                        AutomationProperties.AutomationId="CatchUpUndo" Content="Undo last  Ctrl+Z" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

                            <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Code" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontCode}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Code, Mode=OneWay}" />
                                <ComboBox Grid.Column="1" x:Name="CodeWeightPicker" Style="{StaticResource SettingsPicker}" IsEnabled="False"

                                              FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                              AutomationProperties.Name="Folder" AutomationProperties.AutomationId="AddFeedFolder" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnSpacing="12" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />

<Window x:Class="Fyke.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fyke.App"
    xmlns:vm="using:Fyke.ViewModels"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <Grid x:Name="Root">
        <Grid.Resources>
            <DataTemplate x:Key="FolderChoiceTemplate" x:DataType="vm:FolderChoice">
                <TextBlock Text="{x:Bind Name}" />
            </DataTemplate>
            <Style x:Key="ReadSearchTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource ReadBrush}" />
            </Style>
            <Style x:Key="UnreadSearchTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource UnreadBrush}" />
            </Style>
            <Style x:Key="ActiveArticleMark" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource UnreadBrush}" />
            </Style>
            <Style x:Key="InactiveArticleMark" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource InkSoftBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" />
        <Grid Grid.Row="1" x:Name="ReaderShell" Visibility="Collapsed" SizeChanged="ReaderSizeChanged"
              AutomationProperties.AutomationId="ReaderShell">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="C" Invoked="DiscussionShortcut" />
                <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchShortcut" />
                <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="PaletteShortcut" />
                <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="AddFeedShortcut" />
                <KeyboardAccelerator Key="F6" Invoked="PaneFocusShortcut" />
                <KeyboardAccelerator Key="F6" Modifiers="Shift" Invoked="PaneFocusShortcut" />
                <KeyboardAccelerator Key="M" Invoked="ArticleMarkShortcut" />
                <KeyboardAccelerator Key="S" Invoked="ArticleMarkShortcut" />
                <KeyboardAccelerator Key="R" Invoked="RefreshSubscriptionsShortcut" />
                <KeyboardAccelerator Key="K" Modifiers="Control,Shift" Invoked="MarkAllReadShortcut" />
                <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoBulkShortcut" />
            </Grid.KeyboardAccelerators>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition x:Name="TimelineColumn" Width="368" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="SidebarPane" Padding="12,16,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="10,0,0,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="LIBRARY" FontSize="11" FontFamily="{StaticResource FontUi}" VerticalAlignment="Center"
                               FontWeight="{x:Bind local:ReaderFontWeights.Shared.SectionLabel, Mode=OneWay}"
                               Foreground="{ThemeResource MutedBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="AddFeedButton" Width="32" Height="32" Padding="0"
                                Click="AddFeedClicked" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="AddFeedButton" AutomationProperties.Name="Add feed"
                                AutomationProperties.AcceleratorKey="Ctrl+N" ToolTipService.ToolTip="Add feed (Ctrl+N)">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                        <Button x:Name="PaletteButton" Width="32" Height="32" Padding="0"
                                Click="PaletteClicked" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="PaletteButton" AutomationProperties.Name="Command palette"
                                AutomationProperties.AcceleratorKey="Ctrl+K" ToolTipService.ToolTip="Command palette (Ctrl+K)">
                            <FontIcon Glyph="&#xE765;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ListView Grid.Row="1" x:Name="Destinations" SelectionChanged="DestinationChanged" ItemClick="DestinationClicked"
                          AutomationProperties.Name="Reading destinations" AutomationProperties.AutomationId="ReaderDestinations">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReaderDestination">
                            <Grid Height="32" ColumnSpacing="8" DataContextChanged="ApplyDestinationIndent"
                                  AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14"
                                          Foreground="{ThemeResource InkSoftBrush}" />
                                <Button Width="24" Height="24" Padding="0" Margin="-5,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                                        Background="Transparent" BorderThickness="0" Foreground="{ThemeResource MutedBrush}"
                                        Loaded="FolderDisclosureLoaded" DataContextChanged="FolderDisclosureChanged"
                                        Click="FolderDisclosureClicked"
                                        CornerRadius="{StaticResource RadiusControl}">
                                    <FontIcon FontSize="10" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                           VerticalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind CountText}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                           Foreground="{ThemeResource UnreadBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="2" ColumnSpacing="8" Padding="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SubscriptionStatus" Visibility="Collapsed" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="12" TextWrapping="Wrap" FontFamily="{StaticResource FontUi}"
                           FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                           Foreground="{ThemeResource MutedBrush}" AutomationProperties.LiveSetting="Polite" />
                    <Button Grid.Column="1" x:Name="SettingsButton" Width="32" Height="32" Padding="0"
                            Click="SettingsClicked" CornerRadius="{StaticResource RadiusControl}"
                            AutomationProperties.AutomationId="SettingsButton" AutomationProperties.Name="Settings"
                            AutomationProperties.AcceleratorKey="Ctrl+," ToolTipService.ToolTip="Settings (Ctrl+,)">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                </Grid>
            </Grid>
            <Border Grid.Column="1" Background="{ThemeResource HairlineBrush}" />
            <Grid Grid.Column="2" x:Name="TimelinePane" Background="{ThemeResource GroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="20,16,20,12" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="TimelineHeading" FontSize="24"
                                   FontFamily="{StaticResource FontReading}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Title, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" Foreground="{ThemeResource InkBrush}"
                                   AutomationProperties.AutomationId="TimelineHeading" />
                        <TextBlock x:Name="ViewSummary" FontSize="12" Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                        <Button x:Name="EditViewButton" Width="32" Height="32" Padding="0" Visibility="Collapsed"
                                Click="EditViewClicked" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="EditViewButton" AutomationProperties.Name="Edit view"
                                ToolTipService.ToolTip="Edit view">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        </Button>
                        <Button x:Name="BulkReadButton" Width="32" Height="32" Padding="0" Visibility="Collapsed"
                                Click="MarkAllReadClicked" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="BulkReadButton" AutomationProperties.Name="Mark all read"
                                AutomationProperties.AcceleratorKey="Ctrl+Shift+K" ToolTipService.ToolTip="Mark all read (Ctrl+Shift+K)">
                            <FontIcon Glyph="&#xE8FB;" FontSize="14" />
                        </Button>
                        <Button x:Name="SearchButton" Width="32" Height="32" Padding="0"
                                Click="SearchClicked" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="SearchButton" AutomationProperties.Name="Search feeds"
                                AutomationProperties.AcceleratorKey="Ctrl+F" ToolTipService.ToolTip="Search (Ctrl+F)">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ListView Grid.Row="2" x:Name="Timeline" Margin="8,0" SelectionChanged="ArticleChanged"
                          AutomationProperties.Name="Articles" AutomationProperties.AutomationId="ReaderTimeline">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TimelineArticle">
                            <StackPanel Padding="4,8" Spacing="4" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" MaxLines="2"
                                           FontFamily="{StaticResource FontReading}"
                                           FontWeight="{x:Bind local:ReaderFontWeights.Shared.TimelineTitle, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock Text="{x:Bind FeedTitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                           Foreground="{ThemeResource MutedBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="1" Margin="20,8" Spacing="8" x:Name="TimelineState">
                    <TextBlock x:Name="TimelineMessage" TextWrapping="Wrap" Foreground="{ThemeResource InkSoftBrush}"
                               FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="RetryTimeline" Content="Try again" Height="32" Click="RetryTimelineClicked"
                            FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                            Visibility="Collapsed" CornerRadius="{StaticResource RadiusControl}" />
                </StackPanel>
                <Button Grid.Row="3" x:Name="MoreArticles" Margin="16,8" Height="32" Content="Load more"
                        FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                        Visibility="Collapsed" Click="MoreArticlesClicked" CornerRadius="{StaticResource RadiusControl}" />
            </Grid>
            <primitives:Thumb Grid.Column="3" x:Name="TimelineDivider" IsTabStop="True" UseSystemFocusVisuals="True" DragDelta="TimelineDividerDragged" KeyDown="TimelineDividerKeyDown"
                              AutomationProperties.Name="Resize article list with Left and Right arrow keys">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="{ThemeResource GroundBrush}">
                            <Border HorizontalAlignment="Center" Width="1" Background="{ThemeResource HairlineBrush}" />
                        </Grid>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
            <Grid Grid.Column="4" x:Name="ArticlePane" Background="{ThemeResource GroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="ArticleActions" Margin="24,8,24,0" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MarkStatus" FontSize="13" Visibility="Collapsed" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontFamily="{StaticResource FontUi}"
                               FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                               Foreground="{ThemeResource InkSoftBrush}" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="StarArticle" Width="32" Height="32" Padding="0" Click="StarArticleClicked"
                                CornerRadius="{StaticResource RadiusControl}" AutomationProperties.AutomationId="StarArticle"
                                AutomationProperties.AcceleratorKey="S">
                            <FontIcon x:Name="StarMarkIcon" FontSize="14" />
                        </Button>
                        <Button x:Name="ReadArticle" Width="32" Height="32" Padding="0" Click="ReadArticleClicked"
                                CornerRadius="{StaticResource RadiusControl}" AutomationProperties.AutomationId="ReadArticle"
                                AutomationProperties.AcceleratorKey="M">
                            <FontIcon x:Name="ReadMarkIcon" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="ArticleScroller" Grid.Row="1" IsTabStop="True" UseSystemFocusVisuals="True"
                                  AutomationProperties.Name="Article reader"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ArticleColumn" Margin="24,20" Spacing="12" MaxWidth="640" HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="ArticlePane">
                        <TextBlock x:Name="ArticleHeading" FontSize="32" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   FontFamily="{StaticResource FontReading}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Title, Mode=OneWay}"
                                   AutomationProperties.AutomationId="ArticleHeading"
                                   Foreground="{ThemeResource InkBrush}" />
                        <TextBlock x:Name="ArticleSource" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"
                                   AutomationProperties.AutomationId="ArticleSource"
                                   FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                        <TextBlock x:Name="ArticleStatus" TextWrapping="Wrap" Foreground="{ThemeResource InkSoftBrush}"
                                   FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="RetryArticle" Content="Try again" Click="RetryArticleClicked"
                                FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                Visibility="Collapsed" Height="32" CornerRadius="{StaticResource RadiusControl}" />
                        <StackPanel x:Name="ArticleBody" Spacing="16" AutomationProperties.AutomationId="ArticleBody" />
                        <StackPanel x:Name="ArticleDiscussion" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
                            <Border Style="{StaticResource ArticleRule}" />
                            <TextBlock x:Name="DiscussionHeading" FontSize="15" TextWrapping="Wrap"
                                       FontFamily="{StaticResource FontUi}"
                                       FontWeight="{x:Bind local:ReaderFontWeights.Shared.SectionLabel, Mode=OneWay}"
                                       Foreground="{ThemeResource InkBrush}" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="DiscussionDetail" FontSize="13" TextWrapping="Wrap"
                                       FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                       Foreground="{ThemeResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="DiscussionAction" Height="32" Click="DiscussionActionClicked"
                                        AutomationProperties.AutomationId="DiscussionAction"
                                        AutomationProperties.AcceleratorKey="C"
                                        FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                        CornerRadius="{StaticResource RadiusControl}" />
                                <HyperlinkButton x:Name="DiscussionWebsite" Height="32"
                                                 FontFamily="{StaticResource FontUi}"
                                                 FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
                            </StackPanel>
                            <ItemsRepeater x:Name="DiscussionComments" ElementPrepared="PrepareDiscussionComment"
                                           AutomationProperties.Name="Comments">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <ContentPresenter />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Column="2" Grid.ColumnSpan="3" x:Name="SettingsPane" Visibility="Collapsed"
                  Background="{ThemeResource GroundBrush}" AutomationProperties.Name="Settings">
                <Grid.Resources>
                    <Style x:Key="SettingsTitle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="20" />
                        <Setter Property="FontFamily" Value="{StaticResource FontReading}" />
                        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                    <Style x:Key="SettingsLabel" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
                        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                    <Style x:Key="SettingsDetail" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                    <Style x:Key="SettingsAction" TargetType="Button">
                        <Setter Property="Height" Value="32" />
                        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
                        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
                    </Style>
                    <Style x:Key="SettingsPicker" TargetType="ComboBox">
                        <Setter Property="MinWidth" Value="152" />
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="24,16,24,8">
                    <SelectorBar x:Name="SettingsTabs" HorizontalAlignment="Center"
                                 AutomationProperties.Name="Settings tabs" FontFamily="{StaticResource FontUi}">
                        <SelectorBarItem x:Name="GeneralSettingsTab" Text="General" AutomationProperties.AutomationId="GeneralSettingsTab">
                            <SelectorBarItem.Icon><SymbolIcon Symbol="Setting" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="ReadingSettingsTab" Text="Reading" AutomationProperties.AutomationId="ReadingSettingsTab">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE8D2;" FontSize="14" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>
                    <Button x:Name="CloseSettingsButton" HorizontalAlignment="Right" Width="32" Height="32" Padding="0"
                            Click="CloseSettingsClicked" CornerRadius="{StaticResource RadiusControl}" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="CloseSettingsButton" AutomationProperties.Name="Close Settings"
                            ToolTipService.ToolTip="Close Settings (Esc)">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </Grid>
                <Grid Grid.Row="1" Padding="24,0">
                    <StackPanel Spacing="8" x:Name="SettingsFeedback" Visibility="Collapsed" MaxWidth="640" Margin="0,8">
                        <TextBlock x:Name="SettingsStatus" Style="{StaticResource SettingsDetail}" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="ReloadSettingsButton" Visibility="Collapsed" Content="Try again" Click="ReloadSettingsClicked"
                                Style="{StaticResource SettingsAction}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="2" x:Name="SettingsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              AutomationProperties.AutomationId="SettingsScroll">
                    <Grid Padding="24,16,24,28">
                        <StackPanel x:Name="GeneralSettingsBody" MaxWidth="640" Spacing="24">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Updates" Style="{StaticResource SettingsTitle}" AutomationProperties.HeadingLevel="Level2" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Check for new articles" Style="{StaticResource SettingsLabel}" />
                                        <TextBlock Text="Fyke follows how often each feed posts." Style="{StaticResource SettingsDetail}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Automatic" VerticalAlignment="Center" Style="{StaticResource SettingsDetail}" />
                                </Grid>
                                <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Fetch full articles" Style="{StaticResource SettingsLabel}" />
                                        <TextBlock Text="Replaces short summaries and follows each site’s robots.txt." Style="{StaticResource SettingsDetail}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="FullTextToggle" Toggled="GeneralSettingToggled" IsEnabled="False"
                                                  MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="Fetch full articles"
                                                  AutomationProperties.AutomationId="FullTextToggle" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Privacy" Style="{StaticResource SettingsTitle}" AutomationProperties.HeadingLevel="Level2" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Load images automatically" Style="{StaticResource SettingsLabel}" />
                                        <TextBlock Text="Loading an image can tell its publisher you are reading." Style="{StaticResource SettingsDetail}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="LoadImagesToggle" Toggled="GeneralSettingToggled" IsEnabled="False"
                                                  MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="Load images automatically"
                                                  AutomationProperties.AutomationId="LoadImagesToggle" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Subscriptions and keys" Style="{StaticResource SettingsTitle}" AutomationProperties.HeadingLevel="Level2" />
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Your subscriptions" Style="{StaticResource SettingsLabel}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SettingsImport" Content="Import OPML…" Click="ImportOpmlClicked" Style="{StaticResource SettingsAction}" />
                                        <Button x:Name="SettingsExport" Content="Export OPML…" Click="SettingsExportClicked" Style="{StaticResource SettingsAction}" />
                                    </StackPanel>
                                </StackPanel>
                                <Expander Header="Keyboard shortcuts" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          FontFamily="{StaticResource FontUi}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource SettingsLabel}">Command palette <Run Text="Ctrl+K" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Search articles <Run Text="Ctrl+F" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Add feed <Run Text="Ctrl+N" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Settings <Run Text="Ctrl+," Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Move between panes <Run Text="F6 / Shift+F6" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Refresh feeds <Run Text="R" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Mark read or unread <Run Text="M" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Star or unstar article <Run Text="S" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Show discussion <Run Text="C" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Mark all read <Run Text="Ctrl+Shift+K" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Undo mark all read <Run Text="Ctrl+Z" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                        <TextBlock Style="{StaticResource SettingsLabel}">Close panel <Run Text="Esc" Foreground="{ThemeResource MutedBrush}" /></TextBlock>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="ReadingSettingsBody" MaxWidth="640" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="Appearance" Style="{StaticResource SettingsTitle}" AutomationProperties.HeadingLevel="Level2" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Fixed theme" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="ThemePicker" Style="{StaticResource SettingsPicker}" IsEnabled="False"
                                          SelectionChanged="AppearanceThemeChanged" AutomationProperties.Name="Fixed theme"

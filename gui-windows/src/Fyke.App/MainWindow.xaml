                <StackPanel Spacing="12">
                    <TextBlock x:Name="CatalogEditHeading" FontSize="24" TextWrapping="Wrap"
                               FontFamily="{StaticResource FontReading}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Title, Mode=OneWay}"

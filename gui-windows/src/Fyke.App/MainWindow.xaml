                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{x:Bind}" FontSize="15" TextTrimming="CharacterEllipsis"
                                                                       FontFamily="{StaticResource FontReading}"
                                                                       FontWeight="{x:Bind local:ReaderFontWeights.Shared.Reading, Mode=OneWay}"
                                                                       Foreground="{ThemeResource UnreadBrush}" />

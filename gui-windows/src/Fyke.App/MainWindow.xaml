<Window x:Class="Fyke.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fyke.App"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <Grid x:Name="Root">
        <Grid.Resources>
            <local:ReaderFontWeights x:Key="ReaderFonts" />
            <Style x:Key="ReadSearchTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource ReadBrush}" />
            </Style>
            <Style x:Key="UnreadSearchTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource UnreadBrush}" />
            </Style>
            <Style x:Key="ActiveArticleMark" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource UnreadBrush}" />
            </Style>
            <Style x:Key="InactiveArticleMark" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource InkSoftBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" />
        <Grid Grid.Row="1" x:Name="ReaderShell" Visibility="Collapsed" SizeChanged="ReaderSizeChanged"
              AutomationProperties.AutomationId="ReaderShell">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="C" Invoked="DiscussionShortcut" />
                <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchShortcut" />
                <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="PaletteShortcut" />
                <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="AddFeedShortcut" />
                <KeyboardAccelerator Key="F6" Invoked="PaneFocusShortcut" />
                <KeyboardAccelerator Key="F6" Modifiers="Shift" Invoked="PaneFocusShortcut" />
                <KeyboardAccelerator Key="M" Invoked="ArticleMarkShortcut" />
                <KeyboardAccelerator Key="S" Invoked="ArticleMarkShortcut" />
                <KeyboardAccelerator Key="R" Invoked="RefreshSubscriptionsShortcut" />
                <KeyboardAccelerator Key="K" Modifiers="Control,Shift" Invoked="MarkAllReadShortcut" />
                <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoBulkShortcut" />
            </Grid.KeyboardAccelerators>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition x:Name="TimelineColumn" Width="368" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="SidebarPane" Padding="12,16,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="10,0,0,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="LIBRARY" FontSize="11" FontFamily="{StaticResource FontUi}" VerticalAlignment="Center"
                               FontWeight="{Binding SectionLabel, Source={StaticResource ReaderFonts}}"
                               Foreground="{ThemeResource MutedBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="AddFeedButton" Width="32" Height="32" Padding="0"
                                Click="AddFeedClicked" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="AddFeedButton" AutomationProperties.Name="Add feed"
                                AutomationProperties.AcceleratorKey="Ctrl+N" ToolTipService.ToolTip="Add feed (Ctrl+N)">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                        <Button x:Name="PaletteButton" Width="32" Height="32" Padding="0"
                                Click="PaletteClicked" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="PaletteButton" AutomationProperties.Name="Command palette"
                                AutomationProperties.AcceleratorKey="Ctrl+K" ToolTipService.ToolTip="Command palette (Ctrl+K)">
                            <FontIcon Glyph="&#xE765;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ListView Grid.Row="1" x:Name="Destinations" SelectionChanged="DestinationChanged"
                          AutomationProperties.Name="Reading destinations" AutomationProperties.AutomationId="ReaderDestinations">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="32" ColumnSpacing="8" DataContextChanged="ApplyDestinationIndent"
                                  AutomationProperties.Name="{Binding AccessibleName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{Binding Glyph}" FontSize="14"
                                          Foreground="{ThemeResource InkSoftBrush}" />
                                <Button Width="24" Height="24" Padding="0" Margin="-5,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                                        Background="Transparent" BorderThickness="0" Foreground="{ThemeResource MutedBrush}"
                                        Loaded="FolderDisclosureLoaded" DataContextChanged="FolderDisclosureChanged"
                                        Click="FolderDisclosureClicked"
                                        CornerRadius="{StaticResource RadiusControl}">
                                    <FontIcon FontSize="10" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                           VerticalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding CountText}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                           Foreground="{ThemeResource UnreadBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" x:Name="SubscriptionStatus" Visibility="Collapsed" Margin="10,6,8,4"
                           FontSize="12" TextWrapping="Wrap" FontFamily="{StaticResource FontUi}"
                           FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                           Foreground="{ThemeResource MutedBrush}" AutomationProperties.LiveSetting="Polite" />
            </Grid>
            <Border Grid.Column="1" Background="{ThemeResource HairlineBrush}" />
            <Grid Grid.Column="2" x:Name="TimelinePane" Background="{ThemeResource GroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="20,16,20,12" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimelineHeading" FontSize="24" VerticalAlignment="Center"
                               FontFamily="{StaticResource FontReading}" FontWeight="{Binding Title, Source={StaticResource ReaderFonts}}"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource InkBrush}"
                               AutomationProperties.AutomationId="TimelineHeading" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="BulkReadButton" Width="32" Height="32" Padding="0" Visibility="Collapsed"
                                Click="MarkAllReadClicked" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="BulkReadButton" AutomationProperties.Name="Mark all read"
                                AutomationProperties.AcceleratorKey="Ctrl+Shift+K" ToolTipService.ToolTip="Mark all read (Ctrl+Shift+K)">
                            <FontIcon Glyph="&#xE8FB;" FontSize="14" />
                        </Button>
                        <Button x:Name="SearchButton" Width="32" Height="32" Padding="0"
                                Click="SearchClicked" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.AutomationId="SearchButton" AutomationProperties.Name="Search feeds"
                                AutomationProperties.AcceleratorKey="Ctrl+F" ToolTipService.ToolTip="Search (Ctrl+F)">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ListView Grid.Row="2" x:Name="Timeline" Margin="8,0" SelectionChanged="ArticleChanged"
                          AutomationProperties.Name="Articles" AutomationProperties.AutomationId="ReaderTimeline">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4,8" Spacing="4" AutomationProperties.Name="{Binding AccessibleName}">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2"
                                           FontFamily="{StaticResource FontReading}"
                                           FontWeight="{Binding TimelineTitle, Source={StaticResource ReaderFonts}}"
                                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock Text="{Binding FeedTitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                           Foreground="{ThemeResource MutedBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="1" Margin="20,8" Spacing="8" x:Name="TimelineState">
                    <TextBlock x:Name="TimelineMessage" TextWrapping="Wrap" Foreground="{ThemeResource InkSoftBrush}"
                               FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="RetryTimeline" Content="Try again" Height="32" Click="RetryTimelineClicked"
                            FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                            Visibility="Collapsed" CornerRadius="{StaticResource RadiusControl}" />
                </StackPanel>
                <Button Grid.Row="3" x:Name="MoreArticles" Margin="16,8" Height="32" Content="Load more"
                        FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                        Visibility="Collapsed" Click="MoreArticlesClicked" CornerRadius="{StaticResource RadiusControl}" />
            </Grid>
            <primitives:Thumb Grid.Column="3" IsTabStop="True" UseSystemFocusVisuals="True" DragDelta="TimelineDividerDragged" KeyDown="TimelineDividerKeyDown"
                              AutomationProperties.Name="Resize article list with Left and Right arrow keys">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="{ThemeResource GroundBrush}">
                            <Border HorizontalAlignment="Center" Width="1" Background="{ThemeResource HairlineBrush}" />
                        </Grid>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
            <Grid Grid.Column="4" x:Name="ArticlePane" Background="{ThemeResource GroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="ArticleActions" Margin="24,8,24,0" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MarkStatus" FontSize="13" Visibility="Collapsed" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontFamily="{StaticResource FontUi}"
                               FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                               Foreground="{ThemeResource InkSoftBrush}" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="StarArticle" Width="32" Height="32" Padding="0" Click="StarArticleClicked"
                                CornerRadius="{StaticResource RadiusControl}" AutomationProperties.AutomationId="StarArticle"
                                AutomationProperties.AcceleratorKey="S">
                            <FontIcon x:Name="StarMarkIcon" FontSize="14" />
                        </Button>
                        <Button x:Name="ReadArticle" Width="32" Height="32" Padding="0" Click="ReadArticleClicked"
                                CornerRadius="{StaticResource RadiusControl}" AutomationProperties.AutomationId="ReadArticle"
                                AutomationProperties.AcceleratorKey="M">
                            <FontIcon x:Name="ReadMarkIcon" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="ArticleScroller" Grid.Row="1" IsTabStop="True" UseSystemFocusVisuals="True"
                                  AutomationProperties.Name="Article reader"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20" Spacing="12" MaxWidth="640" HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="ArticlePane">
                        <TextBlock x:Name="ArticleHeading" FontSize="32" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   FontFamily="{StaticResource FontReading}" FontWeight="{Binding Title, Source={StaticResource ReaderFonts}}"
                                   AutomationProperties.AutomationId="ArticleHeading"
                                   Foreground="{ThemeResource InkBrush}" />
                        <TextBlock x:Name="ArticleSource" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"
                                   AutomationProperties.AutomationId="ArticleSource"
                                   FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}" />
                        <TextBlock x:Name="ArticleStatus" TextWrapping="Wrap" Foreground="{ThemeResource InkSoftBrush}"
                                   FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="RetryArticle" Content="Try again" Click="RetryArticleClicked"
                                FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                Visibility="Collapsed" Height="32" CornerRadius="{StaticResource RadiusControl}" />
                        <StackPanel x:Name="ArticleBody" Spacing="16" AutomationProperties.AutomationId="ArticleBody" />
                        <StackPanel x:Name="ArticleDiscussion" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
                            <Border Style="{StaticResource ArticleRule}" />
                            <TextBlock x:Name="DiscussionHeading" FontSize="15" TextWrapping="Wrap"
                                       FontFamily="{StaticResource FontUi}"
                                       FontWeight="{Binding SectionLabel, Source={StaticResource ReaderFonts}}"
                                       Foreground="{ThemeResource InkBrush}" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="DiscussionDetail" FontSize="13" TextWrapping="Wrap"
                                       FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                       Foreground="{ThemeResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="DiscussionAction" Height="32" Click="DiscussionActionClicked"
                                        AutomationProperties.AutomationId="DiscussionAction"
                                        AutomationProperties.AcceleratorKey="C"
                                        FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                        CornerRadius="{StaticResource RadiusControl}" />
                                <HyperlinkButton x:Name="DiscussionWebsite" Height="32"
                                                 FontFamily="{StaticResource FontUi}"
                                                 FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}" />
                            </StackPanel>
                            <ItemsRepeater x:Name="DiscussionComments" ElementPrepared="PrepareDiscussionComment"
                                           AutomationProperties.Name="Comments">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <ContentPresenter />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12" MaxWidth="400"
                    x:Name="InlineState">
            <TextBlock x:Name="MessageText" AutomationProperties.AutomationId="ConnectionMessage" Text="{Binding Message}" FontSize="20" TextWrapping="Wrap"
                       Foreground="{ThemeResource InkBrush}" />
            <TextBlock x:Name="DetailText" Text="{Binding Detail}" TextWrapping="Wrap"
                       Foreground="{ThemeResource InkSoftBrush}" />
            <Button x:Name="RetryButton" AutomationProperties.AutomationId="ConnectionRetry" Content="Try again" Command="{Binding RetryCommand}" Height="32"
                    CornerRadius="{StaticResource RadiusControl}" />
        </StackPanel>
        <Border Grid.Row="1" x:Name="BulkNotice" Visibility="Collapsed" MaxWidth="480" Margin="16"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="16,8,8,8"
                Background="{ThemeResource InkBrush}" CornerRadius="{StaticResource RadiusPanel}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BulkNoticeText" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                           Foreground="{ThemeResource GroundBrush}" AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="1" x:Name="BulkNoticeUndo" Content="Undo" Height="32" VerticalAlignment="Center"
                        Click="UndoBulkClicked" CornerRadius="{StaticResource RadiusControl}"
                        AutomationProperties.AutomationId="BulkNoticeUndo" AutomationProperties.AcceleratorKey="Ctrl+Z"
                        ToolTipService.ToolTip="Undo (Ctrl+Z)"
                        FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}" />
            </Grid>
        </Border>
        <Grid Grid.RowSpan="2" x:Name="SearchOverlay" Visibility="Collapsed" TabFocusNavigation="Cycle">
            <Border Background="{ThemeResource ScrimBrush}" PointerPressed="SearchBackdropPressed" />
            <Border MaxWidth="640" Margin="16,96,16,16" VerticalAlignment="Top"
                    CornerRadius="{StaticResource RadiusSheet}" BorderThickness="1"
                    BorderBrush="{ThemeResource HairlineBrush}" Background="{ThemeResource SurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,16,20,16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchQuery" PlaceholderText="Search your feeds" FontSize="20"
                                 FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                 TextChanged="SearchQueryChanged" AutomationProperties.Name="Search your feeds"
                                 AutomationProperties.AutomationId="SearchQuery" />
                        <TextBlock Grid.Column="1" x:Name="SearchCount" FontSize="13" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                   Foreground="{ThemeResource MutedBrush}" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <Border Grid.Row="1" BorderThickness="0,1,0,1" BorderBrush="{ThemeResource HairlineBrush}">
                        <Grid>
                            <StackPanel x:Name="SearchState" Margin="20,16" Spacing="8">
                                <TextBlock x:Name="SearchStatus" TextWrapping="Wrap" FontSize="14"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                           Foreground="{ThemeResource InkSoftBrush}" AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="RetrySearch" Content="Try again" Height="32" Click="RetrySearchClicked"
                                        FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                        Visibility="Collapsed" CornerRadius="{StaticResource RadiusControl}" />
                            </StackPanel>
                            <ListView x:Name="SearchResults" Margin="8" MaxHeight="512" Visibility="Collapsed"
                                      AutomationProperties.Name="Search results" AutomationProperties.AutomationId="SearchResults">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Button Height="64" Padding="12,8" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                                CornerRadius="{StaticResource RadiusControl}" Click="SearchResultClicked"
                                                AutomationProperties.Name="{Binding AccessibleName}">
                                            <Grid ColumnSpacing="20">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="104" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                               FontSize="18" FontFamily="{StaticResource FontReading}"
                                                               FontWeight="{Binding TimelineTitle, Source={StaticResource ReaderFonts}}"
                                                               DataContextChanged="PrepareSearchTitle" />
                                                    <TextBlock TextTrimming="CharacterEllipsis" FontSize="13"
                                                               FontFamily="{StaticResource FontUi}"
                                                               FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                                               Foreground="{ThemeResource InkSoftBrush}"
                                                               DataContextChanged="PrepareSearchSnippet" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="3" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding FeedTitle}" TextTrimming="CharacterEllipsis"
                                                               TextAlignment="Right" FontSize="13" FontFamily="{StaticResource FontUi}"
                                                               FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                                               Foreground="{ThemeResource MutedBrush}" />
                                                    <TextBlock TextAlignment="Right" FontSize="13" FontFamily="{StaticResource FontUi}"
                                                               Foreground="{ThemeResource MutedBrush}"
                                                               DataContextChanged="PrepareSearchDate" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="20,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="SearchUnread" Content="All articles" Height="32"
                                      Checked="SearchUnreadChanged" Unchecked="SearchUnreadChanged"
                                      FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                      CornerRadius="{StaticResource RadiusControl}" AutomationProperties.Name="Unread only"
                                      AutomationProperties.AutomationId="SearchUnread" />
                        <Button Grid.Column="1" Content="Close" Height="32" Click="CloseSearchClicked"
                                FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                CornerRadius="{StaticResource RadiusControl}" AutomationProperties.AcceleratorKey="Esc" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="2" x:Name="PaletteOverlay" Visibility="Collapsed" TabFocusNavigation="Cycle">
            <Border Background="{ThemeResource ScrimBrush}" PointerPressed="PaletteBackdropPressed" />
            <Border MaxWidth="620" Margin="16,120,16,16" VerticalAlignment="Top"
                    CornerRadius="{StaticResource RadiusSheet}" BorderThickness="1"
                    BorderBrush="{ThemeResource HairlineBrush}" Background="{ThemeResource SurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PaletteQuery" PlaceholderText="Go to, do, or find…" FontSize="18"
                                 FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                 TextChanged="PaletteQueryChanged" AutomationProperties.Name="Command palette"
                                 AutomationProperties.AutomationId="PaletteQuery" />
                        <Button Grid.Column="1" Content="Close" Height="32" VerticalAlignment="Center" Click="ClosePaletteClicked"
                                FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                CornerRadius="{StaticResource RadiusControl}" AutomationProperties.AcceleratorKey="Esc" />
                    </Grid>
                    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource HairlineBrush}">
                        <Grid>
                            <TextBlock x:Name="PaletteStatus" Margin="20,16" TextWrapping="Wrap" FontSize="14"
                                       FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                       Foreground="{ThemeResource InkSoftBrush}" AutomationProperties.LiveSetting="Polite" />
                            <ListView x:Name="PaletteResults" Margin="8" MaxHeight="420"
                                      AutomationProperties.Name="Commands and articles" AutomationProperties.AutomationId="PaletteResults">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Button Height="36" Padding="12,4" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                                CornerRadius="{StaticResource RadiusControl}" Click="PaletteResultClicked"
                                                AutomationProperties.Name="{Binding Title}" AutomationProperties.AcceleratorKey="{Binding Shortcut}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" MaxWidth="140" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                                           Foreground="{ThemeResource InkBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                                           FontSize="12" VerticalAlignment="Center" FontFamily="{StaticResource FontUi}"
                                                           FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}" Foreground="{ThemeResource MutedBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Shortcut}" FontSize="12" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                                           Foreground="{ThemeResource MutedBrush}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="2" x:Name="AddFeedOverlay" Visibility="Collapsed" TabFocusNavigation="Cycle">
            <Border Background="{ThemeResource ScrimBrush}" PointerPressed="AddFeedBackdropPressed" />
            <Border MaxWidth="560" Margin="16,96,16,16" VerticalAlignment="Top"
                    CornerRadius="{StaticResource RadiusSheet}" BorderThickness="1"
                    BorderBrush="{ThemeResource HairlineBrush}" Background="{ThemeResource SurfaceBrush}">
                <Grid Padding="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Add a feed" FontSize="26" Margin="0,0,0,16"
                               FontFamily="{StaticResource FontReading}" FontWeight="{Binding Title, Source={StaticResource ReaderFonts}}"
                               Foreground="{ThemeResource InkBrush}" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBox x:Name="AddFeedAddress" PlaceholderText="Site or feed address" MinHeight="38"
                                     FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                     TextChanged="AddFeedAddressChanged" AutomationProperties.Name="Site or feed address"
                                     AutomationProperties.AutomationId="AddFeedAddress" />
                            <TextBlock x:Name="AddFeedStatus" TextWrapping="Wrap" FontSize="13"
                                       FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                       Foreground="{ThemeResource InkSoftBrush}" AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="AddFeedLocalRetry" Content="Find feeds on the local network" Visibility="Collapsed"
                                    Height="32" Click="AddFeedLocalClicked" CornerRadius="{StaticResource RadiusControl}"
                                    AutomationProperties.AutomationId="AddFeedLocalRetry"
                                    FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}" />
                            <StackPanel x:Name="AddFeedOptions" Spacing="12" Visibility="Collapsed">
                                <ListView x:Name="AddFeedCandidates" SelectionMode="Multiple" MaxHeight="240"
                                          SelectionChanged="AddFeedSelectionChanged" AutomationProperties.Name="Discovered feeds"
                                          AutomationProperties.AutomationId="AddFeedCandidates">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="4" Padding="4,8" AutomationProperties.Name="{Binding DisplayTitle}">
                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="15" TextTrimming="CharacterEllipsis"
                                                           FontFamily="{StaticResource FontUi}" FontWeight="{Binding SectionLabel, Source={StaticResource ReaderFonts}}"
                                                           Foreground="{ThemeResource InkBrush}" />
                                                <TextBlock Text="{Binding Url}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           FontFamily="{StaticResource FontUi}" Foreground="{ThemeResource MutedBrush}" />
                                                <ItemsControl ItemsSource="{Binding Latest}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontSize="15" TextTrimming="CharacterEllipsis"
                                                                       FontFamily="{StaticResource FontReading}"
                                                                       FontWeight="{Binding Reading, Source={StaticResource ReaderFonts}}"
                                                                       Foreground="{ThemeResource UnreadBrush}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Grid x:Name="AddFeedNameRow" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Name" VerticalAlignment="Center" FontFamily="{StaticResource FontUi}"
                                               Foreground="{ThemeResource InkSoftBrush}" />
                                    <TextBox Grid.Column="1" x:Name="AddFeedName" MinHeight="32"
                                             FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                             AutomationProperties.Name="Feed name" AutomationProperties.AutomationId="AddFeedName" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Folder" VerticalAlignment="Center" FontFamily="{StaticResource FontUi}"
                                               Foreground="{ThemeResource InkSoftBrush}" />
                                    <ComboBox Grid.Column="1" x:Name="AddFeedFolder" DisplayMemberPath="Name" MinHeight="32"
                                              HorizontalAlignment="Stretch" FontFamily="{StaticResource FontUi}"
                                              FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                              AutomationProperties.Name="Folder" AutomationProperties.AutomationId="AddFeedFolder" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnSpacing="12" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AddFeedImport" Content="Import OPML…" Height="32" Click="ImportOpmlClicked"
                                CornerRadius="{StaticResource RadiusControl}" FontFamily="{StaticResource FontUi}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CancelAddFeed" Content="Cancel" Height="32" Click="AddFeedCancelClicked"
                                    CornerRadius="{StaticResource RadiusControl}" FontFamily="{StaticResource FontUi}" />
                            <Button x:Name="AddFeedPrimary" Content="Find feeds" Height="32" Click="AddFeedPrimaryClicked"
                                    Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="AddFeedPrimary"
                                    CornerRadius="{StaticResource RadiusControl}" FontFamily="{StaticResource FontUi}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="2" x:Name="CatalogEditOverlay" Visibility="Collapsed" TabFocusNavigation="Cycle">
            <Border Background="{ThemeResource ScrimBrush}" PointerPressed="CatalogEditBackdropPressed" />
            <Border MaxWidth="420" Margin="16,120,16,16" VerticalAlignment="Top" Padding="24"
                    CornerRadius="{StaticResource RadiusSheet}" BorderThickness="1"
                    BorderBrush="{ThemeResource HairlineBrush}" Background="{ThemeResource SurfaceBrush}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="CatalogEditHeading" FontSize="24" TextWrapping="Wrap"
                               FontFamily="{StaticResource FontReading}" FontWeight="{Binding Title, Source={StaticResource ReaderFonts}}"
                               Foreground="{ThemeResource InkBrush}" />
                    <TextBox x:Name="CatalogEditName" PlaceholderText="Name" MinHeight="32" TextChanged="CatalogEditNameChanged"
                             FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                             AutomationProperties.Name="Name" AutomationProperties.AutomationId="CatalogEditName" />
                    <ComboBox x:Name="CatalogMoveTarget" DisplayMemberPath="Name" HorizontalAlignment="Stretch" MinHeight="32"
                              FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                              SelectionChanged="CatalogEditTargetChanged" AutomationProperties.Name="Destination folder"
                              AutomationProperties.AutomationId="CatalogMoveTarget" />
                    <TextBlock x:Name="CatalogEditHint" FontSize="13" TextWrapping="Wrap"
                               FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                               Foreground="{ThemeResource MutedBrush}" />
                    <CheckBox x:Name="CatalogDeleteContents" Content="Also delete everything inside" Visibility="Collapsed"
                              Checked="CatalogDeleteContentsChanged" Unchecked="CatalogDeleteContentsChanged"
                              FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                              AutomationProperties.AutomationId="CatalogDeleteContents" />
                    <TextBlock x:Name="CatalogEditStatus" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                               FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                               Foreground="{ThemeResource InkSoftBrush}" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="CatalogEditCancel" Content="Cancel" Height="32" Click="CatalogEditCancelClicked"
                                AutomationProperties.AutomationId="CatalogEditCancel"
                                FontFamily="{StaticResource FontUi}" CornerRadius="{StaticResource RadiusControl}" />
                        <Button x:Name="CatalogEditConfirm" Height="32" Click="CatalogEditConfirmClicked"
                                Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="CatalogEditConfirm"
                                FontFamily="{StaticResource FontUi}" CornerRadius="{StaticResource RadiusControl}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

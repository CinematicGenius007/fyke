                            <Button x:Name="CancelAddFeed" Content="Cancel" Height="32" Click="AddFeedCancelClicked"
                                    CornerRadius="{StaticResource RadiusControl}" FontFamily="{StaticResource FontUi}" />
                            <Button x:Name="AddFeedPrimary" Content="Find feeds" Height="32" Click="AddFeedPrimaryClicked"
                                    Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="AddFeedPrimary"
                                    CornerRadius="{StaticResource RadiusControl}" FontFamily="{StaticResource FontUi}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

<Window x:Class="Fyke.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fyke.App"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <Grid x:Name="Root">
        <Grid.Resources>
            <local:ReaderFontWeights x:Key="ReaderFonts" />
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" />
        <Grid Grid.Row="1" x:Name="ReaderShell" Visibility="Collapsed" SizeChanged="ReaderSizeChanged"
              AutomationProperties.AutomationId="ReaderShell">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition x:Name="TimelineColumn" Width="368" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Padding="12,16,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="LIBRARY" Margin="10,0,0,8" FontSize="11" FontFamily="{StaticResource FontUi}"
                           FontWeight="{Binding SectionLabel, Source={StaticResource ReaderFonts}}"
                           Foreground="{ThemeResource MutedBrush}" />
                <ListView Grid.Row="1" x:Name="Destinations" SelectionChanged="DestinationChanged"
                          AutomationProperties.Name="Reading destinations" AutomationProperties.AutomationId="ReaderDestinations">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="32" ColumnSpacing="8" DataContextChanged="ApplyDestinationIndent"
                                  AutomationProperties.Name="{Binding AccessibleName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{Binding Glyph}" FontSize="14"
                                          Foreground="{ThemeResource InkSoftBrush}" />
                                <Button Width="24" Height="24" Padding="0" Margin="-5,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                                        Background="Transparent" BorderThickness="0" Foreground="{ThemeResource MutedBrush}"
                                        Loaded="FolderDisclosureLoaded" DataContextChanged="FolderDisclosureChanged"
                                        Click="FolderDisclosureClicked"
                                        CornerRadius="{StaticResource RadiusControl}">
                                    <FontIcon FontSize="10" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                           VerticalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding CountText}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                           Foreground="{ThemeResource UnreadBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Border Grid.Column="1" Background="{ThemeResource HairlineBrush}" />
            <Grid Grid.Column="2" Background="{ThemeResource GroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TimelineHeading" Margin="20,16,20,12" FontSize="24"
                           FontFamily="{StaticResource FontReading}" FontWeight="{Binding Title, Source={StaticResource ReaderFonts}}"
                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource InkBrush}"
                           AutomationProperties.AutomationId="TimelineHeading" />
                <ListView Grid.Row="2" x:Name="Timeline" Margin="8,0" SelectionChanged="ArticleChanged"
                          AutomationProperties.Name="Articles" AutomationProperties.AutomationId="ReaderTimeline">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4,8" Spacing="4" AutomationProperties.Name="{Binding AccessibleName}">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2"
                                           FontFamily="{StaticResource FontReading}"
                                           FontWeight="{Binding TimelineTitle, Source={StaticResource ReaderFonts}}"
                                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock Text="{Binding FeedTitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                                           Foreground="{ThemeResource MutedBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="1" Margin="20,8" Spacing="8" x:Name="TimelineState">
                    <TextBlock x:Name="TimelineMessage" TextWrapping="Wrap" Foreground="{ThemeResource InkSoftBrush}"
                               FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="RetryTimeline" Content="Try again" Height="32" Click="RetryTimelineClicked"
                            FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                            Visibility="Collapsed" CornerRadius="{StaticResource RadiusControl}" />
                </StackPanel>
                <Button Grid.Row="3" x:Name="MoreArticles" Margin="16,8" Height="32" Content="Load more"
                        FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                        Visibility="Collapsed" Click="MoreArticlesClicked" CornerRadius="{StaticResource RadiusControl}" />
            </Grid>
            <primitives:Thumb Grid.Column="3" IsTabStop="True" UseSystemFocusVisuals="True" DragDelta="TimelineDividerDragged" KeyDown="TimelineDividerKeyDown"
                              AutomationProperties.Name="Resize article list with Left and Right arrow keys">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="{ThemeResource GroundBrush}">
                            <Border HorizontalAlignment="Center" Width="1" Background="{ThemeResource HairlineBrush}" />
                        </Grid>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
            <ScrollViewer x:Name="ArticleScroller" Grid.Column="4" Background="{ThemeResource GroundBrush}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" Spacing="12" MaxWidth="640" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="ArticlePane">
                    <TextBlock x:Name="ArticleHeading" FontSize="32" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               FontFamily="{StaticResource FontReading}" FontWeight="{Binding Title, Source={StaticResource ReaderFonts}}"
                               AutomationProperties.AutomationId="ArticleHeading"
                               Foreground="{ThemeResource InkBrush}" />
                    <TextBlock x:Name="ArticleSource" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"
                               FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}" />
                    <TextBlock x:Name="ArticleStatus" TextWrapping="Wrap" Foreground="{ThemeResource InkSoftBrush}"
                               FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                               Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="RetryArticle" Content="Try again" Click="RetryArticleClicked"
                            FontFamily="{StaticResource FontUi}" FontWeight="{Binding Ui, Source={StaticResource ReaderFonts}}"
                            Visibility="Collapsed" Height="32" CornerRadius="{StaticResource RadiusControl}" />
                    <StackPanel x:Name="ArticleBody" Spacing="16" AutomationProperties.AutomationId="ArticleBody" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12" MaxWidth="400"
                    x:Name="InlineState">
            <TextBlock x:Name="MessageText" AutomationProperties.AutomationId="ConnectionMessage" Text="{Binding Message}" FontSize="20" TextWrapping="Wrap"
                       Foreground="{ThemeResource InkBrush}" />
            <TextBlock x:Name="DetailText" Text="{Binding Detail}" TextWrapping="Wrap"
                       Foreground="{ThemeResource InkSoftBrush}" />
            <Button x:Name="RetryButton" AutomationProperties.AutomationId="ConnectionRetry" Content="Try again" Command="{Binding RetryCommand}" Height="32"
                    CornerRadius="{StaticResource RadiusControl}" />
        </StackPanel>
    </Grid>
</Window>

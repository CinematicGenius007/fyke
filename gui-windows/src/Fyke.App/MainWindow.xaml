                                           Style="{StaticResource SettingsDetail}" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource HairlineBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Show scrollbars" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="ScrollbarsPicker" Style="{StaticResource SettingsPicker}" IsEnabled="False"
                                          SelectionChanged="ScrollbarsChanged" AutomationProperties.Name="Show scrollbars"
                                          AutomationProperties.AutomationId="ScrollbarsPicker" />

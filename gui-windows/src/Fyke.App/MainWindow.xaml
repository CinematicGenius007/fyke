                Background="{ThemeResource InkBrush}" CornerRadius="{StaticResource RadiusPanel}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BulkNoticeText" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                           Foreground="{ThemeResource GroundBrush}" AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="1" x:Name="BulkNoticeUndo" Content="Undo" Height="32" VerticalAlignment="Center"
                        Click="UndoBulkClicked" CornerRadius="{StaticResource RadiusControl}"
                        AutomationProperties.AutomationId="BulkNoticeUndo" AutomationProperties.AcceleratorKey="Ctrl+Z"
                        ToolTipService.ToolTip="Undo (Ctrl+Z)"
                        FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" />
            </Grid>
        </Border>
        <Grid Grid.RowSpan="2" x:Name="SearchOverlay" Visibility="Collapsed" TabFocusNavigation="Cycle">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveSearchViewShortcut" />
            </Grid.KeyboardAccelerators>
            <Border Background="{ThemeResource ScrimBrush}" PointerPressed="SearchBackdropPressed" />
            <Border MaxWidth="640" Margin="16,96,16,16" VerticalAlignment="Top"
                    CornerRadius="{StaticResource RadiusSheet}" BorderThickness="1"
                    BorderBrush="{ThemeResource HairlineBrush}" Background="{ThemeResource SurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,16,20,16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchQuery" PlaceholderText="Search your feeds" FontSize="20"
                                 FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                 TextChanged="SearchQueryChanged" AutomationProperties.Name="Search your feeds"
                                 AutomationProperties.AutomationId="SearchQuery" />
                        <TextBlock Grid.Column="1" x:Name="SearchCount" FontSize="13" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                   Foreground="{ThemeResource MutedBrush}" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <Border Grid.Row="1" BorderThickness="0,1,0,1" BorderBrush="{ThemeResource HairlineBrush}">
                        <Grid>
                            <StackPanel x:Name="SearchState" Margin="20,16" Spacing="8">
                                <TextBlock x:Name="SearchStatus" TextWrapping="Wrap" FontSize="14"
                                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                           Foreground="{ThemeResource InkSoftBrush}" AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="RetrySearch" Content="Try again" Height="32" Click="RetrySearchClicked"
                                        FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                        Visibility="Collapsed" CornerRadius="{StaticResource RadiusControl}" />
                            </StackPanel>
                            <ListView x:Name="SearchResults" Margin="8" MaxHeight="512" Visibility="Collapsed"
                                      AutomationProperties.Name="Search results" AutomationProperties.AutomationId="SearchResults">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SearchHit">
                                        <Button Height="64" Padding="12,8" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                                CornerRadius="{StaticResource RadiusControl}" Click="SearchResultClicked"
                                                AutomationProperties.Name="{x:Bind AccessibleName}">
                                            <Grid ColumnSpacing="20">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="104" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"
                                                               FontSize="18" FontFamily="{StaticResource FontReading}"
                                                               FontWeight="{x:Bind local:ReaderFontWeights.Shared.TimelineTitle, Mode=OneWay}"
                                                               DataContextChanged="PrepareSearchTitle" />
                                                    <TextBlock TextTrimming="CharacterEllipsis" FontSize="13"
                                                               FontFamily="{StaticResource FontUi}"
                                                               FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                                               Foreground="{ThemeResource InkSoftBrush}"
                                                               DataContextChanged="PrepareSearchSnippet" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="3" Margin="0,4,0,0">
                                                    <TextBlock Text="{x:Bind FeedTitle}" TextTrimming="CharacterEllipsis"
                                                               TextAlignment="Right" FontSize="13" FontFamily="{StaticResource FontUi}"
                                                               FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                                               Foreground="{ThemeResource MutedBrush}" />
                                                    <TextBlock TextAlignment="Right" FontSize="13" FontFamily="{StaticResource FontUi}"
                                                               Foreground="{ThemeResource MutedBrush}"
                                                               DataContextChanged="PrepareSearchDate" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="20,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="SearchUnread" Content="All articles" Height="32"
                                      Checked="SearchUnreadChanged" Unchecked="SearchUnreadChanged"
                                      FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                      CornerRadius="{StaticResource RadiusControl}" AutomationProperties.Name="Unread only"
                                      AutomationProperties.AutomationId="SearchUnread" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SaveSearchViewButton" Content="Save view…" Height="32" IsEnabled="False"
                                    Click="SaveSearchViewClicked" CornerRadius="{StaticResource RadiusControl}"
                                    FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                    AutomationProperties.AutomationId="SaveSearchViewButton" AutomationProperties.AcceleratorKey="Ctrl+S"
                                    ToolTipService.ToolTip="Save view (Ctrl+S)" />
                            <Button Content="Close" Height="32" Click="CloseSearchClicked"
                                    FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                    CornerRadius="{StaticResource RadiusControl}" AutomationProperties.AcceleratorKey="Esc" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="2" x:Name="PaletteOverlay" Visibility="Collapsed" TabFocusNavigation="Cycle">
            <Border Background="{ThemeResource ScrimBrush}" PointerPressed="PaletteBackdropPressed" />
            <Border MaxWidth="620" Margin="16,120,16,16" VerticalAlignment="Top"
                    CornerRadius="{StaticResource RadiusSheet}" BorderThickness="1"
                    BorderBrush="{ThemeResource HairlineBrush}" Background="{ThemeResource SurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PaletteQuery" PlaceholderText="Go to, do, or find…" FontSize="18"
                                 FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                 TextChanged="PaletteQueryChanged" AutomationProperties.Name="Command palette"
                                 AutomationProperties.AutomationId="PaletteQuery" />
                        <Button Grid.Column="1" Content="Close" Height="32" VerticalAlignment="Center" Click="ClosePaletteClicked"
                                FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                CornerRadius="{StaticResource RadiusControl}" AutomationProperties.AcceleratorKey="Esc" />
                    </Grid>
                    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource HairlineBrush}">
                        <Grid>
                            <TextBlock x:Name="PaletteStatus" Margin="20,16" TextWrapping="Wrap" FontSize="14"
                                       FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                       Foreground="{ThemeResource InkSoftBrush}" AutomationProperties.LiveSetting="Polite" />
                            <ListView x:Name="PaletteResults" Margin="8" MaxHeight="420"
                                      AutomationProperties.Name="Commands and articles" AutomationProperties.AutomationId="PaletteResults">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:PaletteResult">
                                        <Button Height="36" Padding="12,4" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                                CornerRadius="{StaticResource RadiusControl}" Click="PaletteResultClicked"
                                                AutomationProperties.Name="{x:Bind Title}" AutomationProperties.AcceleratorKey="{x:Bind Shortcut}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" MaxWidth="140" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                                           Foreground="{ThemeResource InkBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis"
                                                           FontSize="12" VerticalAlignment="Center" FontFamily="{StaticResource FontUi}"
                                                           FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}" Foreground="{ThemeResource MutedBrush}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Shortcut}" FontSize="12" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                                                           Foreground="{ThemeResource MutedBrush}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

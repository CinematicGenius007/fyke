                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12" MaxWidth="400"
                    x:Name="InlineState">
            <TextBlock x:Name="MessageText" AutomationProperties.AutomationId="ConnectionMessage" Text="{x:Bind ViewModel.Message, Mode=OneWay}" FontSize="20" TextWrapping="Wrap"
                       Foreground="{ThemeResource InkBrush}" />
            <TextBlock x:Name="DetailText" Text="{x:Bind ViewModel.Detail, Mode=OneWay}" TextWrapping="Wrap"
                       Foreground="{ThemeResource InkSoftBrush}" />
            <Button x:Name="RetryButton" AutomationProperties.AutomationId="ConnectionRetry" Content="Try again" Command="{x:Bind ViewModel.RetryCommand}" Height="32"
                    CornerRadius="{StaticResource RadiusControl}" />
        </StackPanel>
        <Border Grid.Row="1" x:Name="BulkNotice" Visibility="Collapsed" MaxWidth="480" Margin="16"

                    <TextBox x:Name="CatalogEditName" PlaceholderText="Name" MinHeight="32" TextChanged="CatalogEditNameChanged"
                             FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                             AutomationProperties.Name="Name" AutomationProperties.AutomationId="CatalogEditName" />
                    <ComboBox x:Name="CatalogMoveTarget" ItemTemplate="{StaticResource FolderChoiceTemplate}" HorizontalAlignment="Stretch" MinHeight="32"
                              FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                              SelectionChanged="CatalogEditTargetChanged" AutomationProperties.Name="Destination folder"
                              AutomationProperties.AutomationId="CatalogMoveTarget" />
                    <TextBlock x:Name="CatalogEditHint" FontSize="13" TextWrapping="Wrap"
                               FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                               Foreground="{ThemeResource MutedBrush}" />
                    <CheckBox x:Name="CatalogDeleteContents" Content="Also delete everything inside" Visibility="Collapsed"
                              Checked="CatalogDeleteContentsChanged" Unchecked="CatalogDeleteContentsChanged"
                              FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                              AutomationProperties.AutomationId="CatalogDeleteContents" />
                    <TextBlock x:Name="CatalogEditStatus" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                               FontFamily="{StaticResource FontUi}" FontWeight="{x:Bind local:ReaderFontWeights.Shared.Ui, Mode=OneWay}"
                               Foreground="{ThemeResource InkSoftBrush}" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="CatalogEditCancel" Content="Cancel" Height="32" Click="CatalogEditCancelClicked"
                                AutomationProperties.AutomationId="CatalogEditCancel"
                                FontFamily="{StaticResource FontUi}" CornerRadius="{StaticResource RadiusControl}" />
                        <Button x:Name="CatalogEditConfirm" Height="32" Click="CatalogEditConfirmClicked"
                                Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="CatalogEditConfirm"
                                FontFamily="{StaticResource FontUi}" CornerRadius="{StaticResource RadiusControl}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
